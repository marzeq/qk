module std.fs

when TargetHasFilesystem {
import std
import std.alloc
import std.ctypes
import std.error
import std.io
import std.libc
import std.strings

let path_is_directory(path: str): (bool, std.error.Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return false, std.error.Error.out_of_memory() }

  let mut result = false
  let mut error = std.error.Error.none()
  when OS == .Windows {
    let attributes = std.libc.get_file_attributes(c_path)
    if attributes == std.libc.InvalidFileAttributes {
      error = std.error.last_error()
    } else {
      result = (attributes & std.libc.FileAttributeDirectory) != 0
    }
  } else {
    let directory = std.libc.opendir(c_path)
    if directory == nil {
      error = std.error.last_error()
    } else {
      result = true
      if std.libc.closedir(directory) != 0 { error = std.error.last_error() }
    }
  }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return result, error
}

pub let exists(path: str): (bool, std.error.Error) {
  let mut file, file_error = std.io.FileReader.open(path)
  if file_error.is_none() {
    let close_error = file.close()
    if close_error.is_error() { return false, close_error }
    return true, std.error.Error.none()
  }
  let directory, directory_error = path_is_directory(path)
  if directory { return true, directory_error }
  return false, file_error
}

pub let Path.exists(self): (bool, std.error.Error) = exists(self.as_str())

pub let is_directory(path: str): (bool, std.error.Error) =
  path_is_directory(path)

pub let Path.is_directory(self): (bool, std.error.Error) =
  is_directory(self.as_str())

pub let is_file(path: str): (bool, std.error.Error) {
  let directory, directory_error = is_directory(path)
  if directory { return false, directory_error }
  let mut file, error = std.io.FileReader.open(path)
  if error.is_error() { return false, error }
  error = file.close()
  return error.is_none(), error
}

pub let Path.is_file(self): (bool, std.error.Error) = is_file(self.as_str())

pub let Path.open_reader(self): (std.io.FileReader, std.error.Error) =
  std.io.FileReader.open(self.as_str())

pub let Path.open_writer(
  self,
  append: bool = false,
): (std.io.FileWriter, std.error.Error) =
  std.io.FileWriter.open(self.as_str(), append)

pub let file_size(path: str): (usz, std.error.Error) {
  let mut file, error = std.io.FileReader.open(path)
  if error.is_error() { return 0, error }
  let handle = file.handle.(*std.libc.FILE)

  if std.libc.fseek(handle, 0, .End) != 0 {
    error = std.error.last_error()
    file.close()
    return 0, error
  }
  let size = std.libc.ftell(handle)
  if size < 0 {
    error = std.error.last_error()
    file.close()
    return 0, error
  }
  error = file.close()
  if error.is_error() { return 0, error }
  return size.(usz), std.error.Error.none()
}

pub let Path.file_size(self): (usz, std.error.Error) = file_size(self.as_str())

pub let read_file(
  allocator: *mut dyn std.alloc.Allocator,
  path: str,
): (std.strings.StringBuilder, std.error.Error) {
  let mut result = std.strings.StringBuilder.init(allocator)
  let mut file, error = std.io.FileReader.open(path)
  if error.is_error() { return result, error }

  let reader = file.&mut.(*mut dyn std.io.Reader)
  let _, read_error = reader.read_to_builder(result.&mut)
  let close_error = file.close()
  if read_error.is_error() {
    result.deinit()
    return std.strings.StringBuilder.init(allocator), read_error
  }
  if close_error.is_error() {
    result.deinit()
    return std.strings.StringBuilder.init(allocator), close_error
  }
  return result, std.error.Error.none()
}

pub let Path.read_file(
  self,
  allocator: *mut dyn std.alloc.Allocator,
): (std.strings.StringBuilder, std.error.Error) =
  read_file(allocator, self.as_str())

pub let write_file(path: str, contents: []u8): std.error.Error {
  let mut file, error = std.io.FileWriter.open(path)
  if error.is_error() { return error }
  let _, write_error = file.write_all(contents)
  let close_error = file.close()
  if write_error.is_error() { return write_error }
  return close_error
}

pub let Path.write_file(self, contents: []u8): std.error.Error =
  write_file(self.as_str(), contents)

pub let append_file(path: str, contents: []u8): std.error.Error {
  let mut file, error = std.io.FileWriter.open(path, true)
  if error.is_error() { return error }
  let _, write_error = file.write_all(contents)
  let close_error = file.close()
  if write_error.is_error() { return write_error }
  return close_error
}

pub let Path.append_file(self, contents: []u8): std.error.Error =
  append_file(self.as_str(), contents)

pub let remove(path: str): std.error.Error {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return std.error.Error.out_of_memory() }
  let status = std.libc.remove(c_path)
  let error = if status == 0 { std.error.Error.none() } else { std.error.last_error() }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return error
}

pub let Path.remove(self): std.error.Error = remove(self.as_str())

let create_directory_once(path: str, ok_if_exists: bool): std.error.Error {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return std.error.Error.out_of_memory() }

  let mut status: i32 = 0
  when OS == .Windows { status = std.libc.mkdir(c_path) }
  else { status = std.libc.mkdir(c_path, 493) }
  let error = if status == 0 { std.error.Error.none() } else { std.error.last_error() }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  if error.is_error() && ok_if_exists {
    let directory, _ = is_directory(path)
    if directory { return std.error.Error.none() }
  }
  return error
}

pub let create_directory(
  path: str,
  ok_if_exists: bool = false,
  recursive: bool = false,
): std.error.Error {
  if recursive {
    let parent = dirname(path)
    if !parent.eq(path) {
      let error = create_directory(parent, true, true)
      if error.is_error() { return error }
    }
  }
  return create_directory_once(path, ok_if_exists)
}

pub let Path.create_directory(
  self,
  ok_if_exists: bool = false,
  recursive: bool = false,
): std.error.Error = create_directory(self.as_str(), ok_if_exists, recursive)

pub let remove_directory(path: str): std.error.Error {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return std.error.Error.out_of_memory() }
  let status = std.libc.rmdir(c_path)
  let error = if status == 0 { std.error.Error.none() } else { std.error.last_error() }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return error
}

pub let Path.remove_directory(self): std.error.Error =
  remove_directory(self.as_str())

pub let rename(from: str, to: str): std.error.Error {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_from = from.to_cstr(allocator)
  if c_from == nil { return std.error.Error.out_of_memory() }
  let c_to = to.to_cstr(allocator)
  if c_to == nil {
    allocator.free_bytes(c_from, @len(from) + 1, @alignof(u8))
    return std.error.Error.out_of_memory()
  }
  let status = std.libc.rename(c_from, c_to)
  let error = if status == 0 { std.error.Error.none() } else { std.error.last_error() }
  allocator.free_bytes(c_to, @len(to) + 1, @alignof(u8))
  allocator.free_bytes(c_from, @len(from) + 1, @alignof(u8))
  return error
}

pub let Path.rename(self, to: str): std.error.Error = rename(self.as_str(), to)

pub let change_directory(path: str): std.error.Error {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return std.error.Error.out_of_memory() }
  let status = std.libc.chdir(c_path)
  let error = if status == 0 { std.error.Error.none() } else { std.error.last_error() }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return error
}

pub let Path.change_directory(self): std.error.Error =
  change_directory(self.as_str())

pub let current_directory(
  allocator: *mut dyn std.alloc.Allocator,
): (Path, std.error.Error) {
  let mut capacity: usz = 256
  for true {
    let mut result, allocated = Path.with_capacity(allocator, capacity)
    if !allocated { return result, std.error.Error.out_of_memory() }
    let mut path: *mut std.ctypes.char = nil
    when OS == .Windows {
      path = std.libc.getcwd(result.bytes.ptr.(*mut std.ctypes.char), capacity.(i32))
    } else {
      path = std.libc.getcwd(result.bytes.ptr.(*mut std.ctypes.char), capacity)
    }
    if path != nil {
      let mut length: usz = 0
      for result.bytes.ptr[length] != '\0' { length += 1 }
      result.bytes.count = length
      return result, std.error.Error.none()
    }
    let error = std.error.last_error()
    result.deinit()
    if capacity >= 1048576 || capacity > (~0.(usz)) / 2 {
      return Path.init(allocator), error
    }
    capacity *= 2
  }
  return Path.init(allocator), std.error.Error.no_progress()
}
}
