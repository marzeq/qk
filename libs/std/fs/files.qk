module std.fs

when TargetHasFilesystem {
import std
import std.alloc
import std.ctypes
import std.io
import std.libc
import std.os
import std.strings

let path_is_directory(path: str): Result(bool, Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .Err(Error.OutOfMemory) }

  let mut result = false
  let mut failure: Option(Error) = .None
  when OS == .Windows {
    let attributes = std.libc.get_file_attributes(c_path)
    if attributes == std.libc.InvalidFileAttributes {
      failure = Option(Error).Some(std.os.last_error())
    } else {
      result = (attributes & std.libc.FileAttributeDirectory) != 0
    }
  } else {
    let directory = std.libc.opendir(c_path)
    if directory == nil {
      failure = Option(Error).Some(std.os.last_error())
    } else {
      result = true
      if std.libc.closedir(directory) != 0 { failure = Option(Error).Some(std.os.last_error()) }
    }
  }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  if failure.is_some() { return .Err(failure.unwrap()) }
  return .Ok(result)
}

pub let exists(path: str): Result(bool, Error) {
  let file_result = std.io.FileReader.open(path)
  if file_result.is_ok() {
    let mut file = file_result.unwrap()
    let close_result = file.close()
    if close_result.is_err() { return .Err(close_result.unwrap_err()) }
    return .Ok(true)
  }
  let directory_result = path_is_directory(path)
  if directory_result.is_ok() && directory_result.unwrap() { return .Ok(true) }
  return .Err(file_result.unwrap_err())
}

pub let Path.exists(self): Result(bool, Error) = exists(self.as_str())

pub let is_directory(path: str): Result(bool, Error) =
  path_is_directory(path)

pub let Path.is_directory(self): Result(bool, Error) =
  is_directory(self.as_str())

pub let is_file(path: str): Result(bool, Error) {
  let directory = match is_directory(path) {
    .Ok(value) => value,
    .Err(error) => { return .Err(error) },
  }
  if directory { return .Ok(false) }
  let mut file = match std.io.FileReader.open(path) {
    .Ok(value) => value,
    .Err(error) => { return .Err(error) },
  }
  return match file.close() {
    .Ok(_) => .Ok(true),
    .Err(error) => .Err(error),
  }
}

pub let Path.is_file(self): Result(bool, Error) = is_file(self.as_str())

pub let Path.open_reader(self): Result(std.io.FileReader, Error) =
  std.io.FileReader.open(self.as_str())

pub let Path.open_writer(
  self,
  append: bool = false,
): Result(std.io.FileWriter, Error) =
  std.io.FileWriter.open(self.as_str(), append)

pub let file_size(path: str): Result(usz, Error) {
  let mut file = match std.io.FileReader.open(path) {
    .Ok(value) => value,
    .Err(error) => { return .Err(error) },
  }
  let handle = file.handle.(*std.libc.FILE)

  if std.libc.fseek(handle, 0, .End) != 0 {
    let error = std.os.last_error()
    file.close()
    return .Err(error)
  }
  let size = std.libc.ftell(handle)
  if size < 0 {
    let error = std.os.last_error()
    file.close()
    return .Err(error)
  }
  let close_result = file.close()
  if close_result.is_err() { return .Err(close_result.unwrap_err()) }
  return .Ok(size.(usz))
}

pub let Path.file_size(self): Result(usz, Error) = file_size(self.as_str())

pub let read_file(
  allocator: *mut dyn std.alloc.Allocator,
  path: str,
): Result(std.strings.StringBuilder, Error) {
  let mut result = std.strings.StringBuilder.init(allocator)
  let mut file = match std.io.FileReader.open(path) {
    .Ok(value) => value,
    .Err(error) => { return .Err(error) },
  }

  let reader = file.&mut.(*mut dyn std.io.Reader)
  let read_result = reader.read_to_builder(result.&mut)
  let close_result = file.close()
  if read_result.is_err() {
    result.deinit()
    return .Err(read_result.unwrap_err())
  }
  if close_result.is_err() {
    result.deinit()
    return .Err(close_result.unwrap_err())
  }
  return .Ok(result)
}

pub let Path.read_file(
  self,
  allocator: *mut dyn std.alloc.Allocator,
): Result(std.strings.StringBuilder, Error) =
  read_file(allocator, self.as_str())

pub let write_file(path: str, contents: []u8): Result(Unit, Error) {
  let mut file = match std.io.FileWriter.open(path) {
    .Ok(value) => value,
    .Err(error) => { return .Err(error) },
  }
  let write_result = file.write_all(contents)
  let close_result = file.close()
  if write_result.is_err() { return .Err(write_result.unwrap_err()) }
  return close_result
}

pub let Path.write_file(self, contents: []u8): Result(Unit, Error) =
  write_file(self.as_str(), contents)

pub let append_file(path: str, contents: []u8): Result(Unit, Error) {
  let mut file = match std.io.FileWriter.open(path, true) {
    .Ok(value) => value,
    .Err(error) => { return .Err(error) },
  }
  let write_result = file.write_all(contents)
  let close_result = file.close()
  if write_result.is_err() { return .Err(write_result.unwrap_err()) }
  return close_result
}

pub let Path.append_file(self, contents: []u8): Result(Unit, Error) =
  append_file(self.as_str(), contents)

pub let remove(path: str): Result(Unit, Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .Err(Error.OutOfMemory) }
  let status = std.libc.remove(c_path)
  let error = if status == 0 { Option(Error).None } else { Option(Error).Some(std.os.last_error()) }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  if error.is_some() { return .Err(error.unwrap()) }
  return .Ok(Unit.{})
}

pub let Path.remove(self): Result(Unit, Error) = remove(self.as_str())

let create_directory_once(path: str, ok_if_exists: bool): Result(Unit, Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .Err(Error.OutOfMemory) }

  let mut status: i32 = 0
  when OS == .Windows { status = std.libc.mkdir(c_path) }
  else { status = std.libc.mkdir(c_path, 493) }
  let error = if status == 0 { Option(Error).None } else { Option(Error).Some(std.os.last_error()) }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  if error.is_some() && ok_if_exists {
    let directory = is_directory(path)
    if directory.is_ok() && directory.unwrap() { return .Ok(Unit.{}) }
  }
  if error.is_some() { return .Err(error.unwrap()) }
  return .Ok(Unit.{})
}

pub let create_directory(
  path: str,
  ok_if_exists: bool = false,
  recursive: bool = false,
): Result(Unit, Error) {
  if recursive {
    let parent = dirname(path)
    if !parent.eq(path) {
      let error = create_directory(parent, true, true)
      if error.is_err() { return error }
    }
  }
  return create_directory_once(path, ok_if_exists)
}

pub let Path.create_directory(
  self,
  ok_if_exists: bool = false,
  recursive: bool = false,
): Result(Unit, Error) = create_directory(self.as_str(), ok_if_exists, recursive)

pub let remove_directory(path: str): Result(Unit, Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .Err(Error.OutOfMemory) }
  let status = std.libc.rmdir(c_path)
  let error = if status == 0 { Option(Error).None } else { Option(Error).Some(std.os.last_error()) }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  if error.is_some() { return .Err(error.unwrap()) }
  return .Ok(Unit.{})
}

pub let Path.remove_directory(self): Result(Unit, Error) =
  remove_directory(self.as_str())

pub let rename(from: str, to: str): Result(Unit, Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_from = from.to_cstr(allocator)
  if c_from == nil { return .Err(Error.OutOfMemory) }
  let c_to = to.to_cstr(allocator)
  if c_to == nil {
    allocator.free_bytes(c_from, @len(from) + 1, @alignof(u8))
    return .Err(Error.OutOfMemory)
  }
  let status = std.libc.rename(c_from, c_to)
  let error = if status == 0 { Option(Error).None } else { Option(Error).Some(std.os.last_error()) }
  allocator.free_bytes(c_to, @len(to) + 1, @alignof(u8))
  allocator.free_bytes(c_from, @len(from) + 1, @alignof(u8))
  if error.is_some() { return .Err(error.unwrap()) }
  return .Ok(Unit.{})
}

pub let Path.rename(self, to: str): Result(Unit, Error) = rename(self.as_str(), to)

pub let change_directory(path: str): Result(Unit, Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .Err(Error.OutOfMemory) }
  let status = std.libc.chdir(c_path)
  let error = if status == 0 { Option(Error).None } else { Option(Error).Some(std.os.last_error()) }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  if error.is_some() { return .Err(error.unwrap()) }
  return .Ok(Unit.{})
}

pub let Path.change_directory(self): Result(Unit, Error) =
  change_directory(self.as_str())

pub let current_directory(
  allocator: *mut dyn std.alloc.Allocator,
): Result(Path, Error) {
  let mut capacity: usz = 256
  for true {
    let mut result, allocated = Path.with_capacity(allocator, capacity)
    if !allocated { return .Err(Error.OutOfMemory) }
    let mut path: *mut std.ctypes.char = nil
    when OS == .Windows {
      path = std.libc.getcwd(result.bytes.ptr.(*mut std.ctypes.char), capacity.(i32))
    } else {
      path = std.libc.getcwd(result.bytes.ptr.(*mut std.ctypes.char), capacity)
    }
    if path != nil {
      let mut length: usz = 0
      for result.bytes.ptr[length] != '\0' { length += 1 }
      result.bytes.count = length
      return .Ok(result)
    }
    let error = std.os.last_error()
    result.deinit()
    if capacity >= 1048576 || capacity > (~0.(usz)) / 2 {
      return .Err(error)
    }
    capacity *= 2
  }
  return .Err(Error.NoProgress)
}
}
