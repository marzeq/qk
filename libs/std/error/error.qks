module std.error

// Error code zero represents success. Positive codes are native platform or
// libc errors. Negative codes are portable errors produced by the QK standard
// library itself.
pub let Error = type struct {
  code: i32,
}

pub let Error.none(): Error = .{ code=0 }

pub let Error.from_code(code: i32): Error = .{ code=code }

pub let Error.out_of_memory(): Error = .{ code=-1 }

pub let Error.invalid_handle(): Error = .{ code=-2 }

pub let Error.no_progress(): Error = .{ code=-3 }

pub let Error.invalid_data(): Error = .{ code=-4 }

pub let Error.out_of_range(): Error = .{ code=-5 }

pub let Error.io_failed(): Error = .{ code=-6 }

pub let Error.not_found(): Error = .{ code=-7 }

pub let Error.is_none(self): bool = self.code == 0

pub let Error.is_error(self): bool = self.code != 0

when TargetHasLibc { import std.libc }

// A native message is a borrowed view into platform-owned storage. Portable
// library errors have stable messages and remain available without libc.
pub let Error.message(self): str {
  if self.code == 0 { return "no error" }
  if self.code == -1 { return "out of memory" }
  if self.code == -2 { return "invalid handle" }
  if self.code == -3 { return "operation made no progress" }
  if self.code == -4 { return "invalid data" }
  if self.code == -5 { return "value out of range" }
  if self.code == -6 { return "input/output operation failed" }
  if self.code == -7 { return "not found" }
  when TargetHasLibc {
    let message = std.libc.strerror(self.code)
    if message == nil { return "unknown error" }
    let mut length: usz = 0
    for message[length] != '\0' { length += 1 }
    return message[0:length].(str)
  } else {
    return "native error"
  }
}

when TargetHasLibc {
  pub let last_error(): Error =
    Error.from_code(std.libc.errno_location().*)
}
