module std.os

when TargetHasEnvironment {
  pub let mut args: []str = ---
  pub let mut env: [][2]str = ---
}

when TargetHasLibc {
  import std.libc

  pub let last_error(): Error = Error.Native(std.libc.errno_location().*)
}

when TargetHasEnvironment {
  import std.alloc
  import std.strings

  let environment_name_matches(entry: [2]str, name: str): bool {
    if @len(entry[0]) != @len(name) { return false }
    let mut index: usz = 0
    for index < @len(name) {
      if entry[0][index] != name[index] { return false }
      index += 1
    }
    return true
  }

  // Returns a borrowed view into the environment captured at process startup.
  pub let getenv(name: str): (str, bool) {
    for entry in env {
      if environment_name_matches(entry, name) { return entry[1], true }
    }
    return "", false
  }

  // Copies an environment variable into allocator-owned storage.
  pub let getenv_owned(
    allocator: *mut dyn std.alloc.Allocator,
    name: str,
  ): Result(std.strings.StringBuilder, Error) {
    let value, found = getenv(name)
    let mut result = std.strings.StringBuilder.init(allocator)
    if !found { return .Err(Error.NotFound) }
    if !result.append(value.([]u8)) {
      result.deinit()
      return .Err(Error.OutOfMemory)
    }
    return .Ok(result)
  }

}

when TargetHasProcessExit {
  import std.libc
  pub let exit(code: i32): void @noreturn {
    std.libc.exit(code)
  }
}
