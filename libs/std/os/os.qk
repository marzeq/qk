module std.os

pub let mut args: []str = ---
pub let mut env: [][2]str = ---

when TargetHasEnvironment {
  import std.alloc
  import std.error
  import std.strings

  let environment_name_matches(entry: [2]str, name: str): bool {
    if @len(entry[0]) != @len(name) { return false }
    let mut index: usz = 0
    for index < @len(name) {
      if entry[0][index] != name[index] { return false }
      index += 1
    }
    return true
  }

  // Returns a borrowed view into the environment captured at process startup.
  pub let getenv(name: str): (str, bool) {
    for entry in env {
      if environment_name_matches(entry, name) { return entry[1], true }
    }
    return "", false
  }

  // Copies an environment variable into allocator-owned storage.
  pub let getenv_owned(
    allocator: *mut dyn std.alloc.Allocator,
    name: str,
  ): (std.strings.StringBuilder, std.error.Error) {
    let value, found = getenv(name)
    let mut result = std.strings.StringBuilder.init(allocator)
    if !found { return result, std.error.Error.not_found() }
    if !result.append(value.([]u8)) {
      result.deinit()
      return std.strings.StringBuilder.init(allocator), std.error.Error.out_of_memory()
    }
    return result, std.error.Error.none()
  }

}

when TargetHasProcessExit {
  when OS == .Windows {
    let exit_process(code: u32): void @foreign(symbol "ExitProcess") @noreturn

    pub let exit(code: i32): void @noreturn {
      exit_process(code.(u32))
    }
  } else {
    pub let exit(code: i32): void @noreturn {
      let syscall: u64 =
        when OS == .Linux && Arch == .X86_64 { 60 }
        else when OS == .Linux && Arch == .AArch64 { 93 }
        else when OS == .MacOS { 33554433 }
        else { 1 }

      when Arch == .X86_64 {
        let _ = @asm(
          "syscall",
          out i64 "={rax}",
          in syscall "{rax}",
          in code.(i64) "{rdi}",
          clobber "rcx",
          clobber "r11",
          clobber "memory",
          volatile)
      } else when Arch == .AArch64 && OS == .MacOS {
        let _ = @asm(
          "svc #0x80",
          out i64 "={x0}",
          in syscall "{x16}",
          in code.(i64) "{x0}",
          clobber "memory",
          volatile)
      } else when Arch == .AArch64 {
        let _ = @asm(
          "svc #0",
          out i64 "={x0}",
          in syscall "{x8}",
          in code.(i64) "{x0}",
          clobber "memory",
          volatile)
      }
      for true {}
    }
  }
}
