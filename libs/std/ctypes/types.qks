module std.ctypes

when CCharSigned {
  pub let char = type alias i8
} else {
  pub let char = type alias u8
}
pub let signed_char = type alias i8
pub let unsigned_char = type alias u8

pub let short = type alias i16
pub let signed_short = type alias i16
pub let unsigned_short = type alias u16

pub let int = type alias i32
pub let signed_int = type alias i32
pub let unsigned_int = type alias u32

pub let bool = type alias u8

when OS == .Windows || PointerBits == 32 {
  pub let long = type alias i32
  pub let unsigned_long = type alias u32
} else when PointerBits == 64 {
  pub let long = type alias i64
  pub let unsigned_long = type alias u64
} else {
  @compiler_error("Unsupported C long width")
}

pub let signed_long = type alias long

pub let long_long = type alias i64
pub let signed_long_long = type alias i64
pub let unsigned_long_long = type alias u64

pub let float = type alias f32
pub let double = type alias f64

pub let size_t = type alias usz
pub let ptrdiff_t = type alias isz
pub let ssize_t = type alias isz

pub let va_list = type alias *mut void

// Exact widths of wchar_t are ABI/platform dependent.
when OS == .Windows {
  pub let wchar_t = type alias u16
} else {
  pub let wchar_t = type alias i32
}

pub let char16_t = type alias u16
pub let char32_t = type alias u32

pub let int8_t = type alias i8
pub let uint8_t = type alias u8
pub let int16_t = type alias i16
pub let uint16_t = type alias u16
pub let int32_t = type alias i32
pub let uint32_t = type alias u32
pub let int64_t = type alias i64
pub let uint64_t = type alias u64

pub let intptr_t = type alias isz
pub let uintptr_t = type alias usz

pub let intmax_t = type alias i64
pub let uintmax_t = type alias u64
