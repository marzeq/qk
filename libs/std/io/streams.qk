module std.io

import std.error
import std.strings

pub let Writer = type trait {
  let write(*mut self, bytes: []u8): (usz, std.error.Error)

  let write_builder(
    *mut self,
    builder: *std.strings.StringBuilder,
  ): (usz, std.error.Error) = self.write(builder.as_str().([]u8))
}

pub let Reader = type trait {
  let read(*mut self, buffer: []mut u8): (usz, std.error.Error)

  let read_to_builder(
    *mut self,
    builder: *mut std.strings.StringBuilder,
  ): (usz, std.error.Error) {
    let mut total: usz = 0
    let mut buffer: [4096]u8 = ---
    for true {
      let count, error = self.read(buffer[:])
      if error.is_error() { return total, error }
      if count == 0 { return total, std.error.Error.none() }
      let written, write_error = builder.write(buffer[0:count])
      total += written
      if write_error.is_error() { return total, write_error }
      if written != count { return total, std.error.Error.no_progress() }
    }
    return total, std.error.Error.none()
  }
}

pub let ConsoleWriter = type struct {
  descriptor: i32,
}

pub let ConsoleReader = type struct {
  descriptor: i32,
}

pub let ConsoleReader.read(*mut self, buffer: []mut u8): (usz, std.error.Error) {
  if @len(buffer) == 0 { return 0, std.error.Error.none() }

  when OS == .Windows {
    let handle = _get_std_handle(-10)
    if handle == nil { return 0, std.error.Error.invalid_handle() }
    let mut read: u32 = 0
    let ok = _read_file(
      handle,
      buffer.(*mut u8),
      if @len(buffer) > 4294967295 { 4294967295 } else { @len(buffer).(u32) },
      read.&mut,
      nil,
    )
    if ok == 0 { return 0, std.error.Error.io_failed() }
    return read.(usz), std.error.Error.none()
  } else when Arch == .X86_64 {
    let syscall: u64 =
      when OS == .Linux { 0 }
      else when OS == .MacOS { 33554435 }
      else when OS == .FreeBSD { 3 }
      else when OS == .OpenBSD { 3 }
      else when OS == .NetBSD { 3 }
      else when OS == .DragonFly { 3 }
      else { 0 }
    let result = @asm(
      "syscall",
      out i64 "={rax}",
      in syscall "{rax}",
      in self.descriptor.(i64) "{rdi}",
      in buffer.(*mut u8) "{rsi}",
      in @len(buffer) "{rdx}",
      clobber "rcx",
      clobber "r11",
      clobber "memory",
      volatile)
    if result < 0 { return 0, std.error.Error.from_code((-result).(i32)) }
    return result.(usz), std.error.Error.none()
  } else when Arch == .AArch64 {
    let syscall: u64 =
      when OS == .Linux { 63 }
      else when OS == .MacOS { 33554435 }
      else when OS == .FreeBSD { 3 }
      else when OS == .OpenBSD { 3 }
      else when OS == .NetBSD { 3 }
      else when OS == .DragonFly { 3 }
      else { 0 }
    when OS == .MacOS {
      let result = @asm(
        "svc #0x80",
        out i64 "={x0}",
        in syscall "{x16}",
        in self.descriptor.(i64) "{x0}",
        in buffer.(*mut u8) "{x1}",
        in @len(buffer) "{x2}",
        clobber "memory",
        volatile)
      if result < 0 { return 0, std.error.Error.from_code((-result).(i32)) }
      return result.(usz), std.error.Error.none()
    } else {
      let result = @asm(
        "svc #0",
        out i64 "={x0}",
        in syscall "{x8}",
        in self.descriptor.(i64) "{x0}",
        in buffer.(*mut u8) "{x1}",
        in @len(buffer) "{x2}",
        clobber "memory",
        volatile)
      if result < 0 { return 0, std.error.Error.from_code((-result).(i32)) }
      return result.(usz), std.error.Error.none()
    }
  } else {
    return 0, std.error.Error.io_failed()
  }
}

pub let ConsoleWriter.write(*mut self, bytes: []u8): (usz, std.error.Error) {
  if @len(bytes) == 0 { return 0, std.error.Error.none() }

  when OS == .Windows {
    let handle = _get_std_handle(if self.descriptor == 1 { -11 } else { -12 })
    if handle == nil { return 0, std.error.Error.invalid_handle() }
    let mut written: u32 = 0
    let ok = _write_file(
      handle,
      bytes.(*u8),
      if @len(bytes) > 4294967295 { 4294967295 } else { @len(bytes).(u32) },
      written.&mut,
      nil,
    )
    if ok == 0 { return 0, std.error.Error.io_failed() }
    return written.(usz), std.error.Error.none()
  } else when Arch == .X86_64 {
    let syscall: u64 =
      when OS == .Linux { 1 }
      else when OS == .MacOS { 33554436 }
      else when OS == .FreeBSD { 4 }
      else when OS == .OpenBSD { 4 }
      else when OS == .NetBSD { 4 }
      else when OS == .DragonFly { 4 }
      else { 0 }
    let result = @asm(
      "syscall",
      out i64 "={rax}",
      in syscall "{rax}",
      in self.descriptor.(i64) "{rdi}",
      in bytes.(*u8) "{rsi}",
      in @len(bytes) "{rdx}",
      clobber "rcx",
      clobber "r11",
      clobber "memory",
      volatile)
    if result < 0 { return 0, std.error.Error.from_code((-result).(i32)) }
    return result.(usz), std.error.Error.none()
  } else when Arch == .AArch64 {
    let syscall: u64 =
      when OS == .Linux { 64 }
      else when OS == .MacOS { 33554436 }
      else when OS == .FreeBSD { 4 }
      else when OS == .OpenBSD { 4 }
      else when OS == .NetBSD { 4 }
      else when OS == .DragonFly { 4 }
      else { 0 }
    when OS == .MacOS {
      let result = @asm(
        "svc #0x80",
        out i64 "={x0}",
        in syscall "{x16}",
        in self.descriptor.(i64) "{x0}",
        in bytes.(*u8) "{x1}",
        in @len(bytes) "{x2}",
        clobber "memory",
        volatile)
      if result < 0 { return 0, std.error.Error.from_code((-result).(i32)) }
      return result.(usz), std.error.Error.none()
    } else {
      let result = @asm(
        "svc #0",
        out i64 "={x0}",
        in syscall "{x8}",
        in self.descriptor.(i64) "{x0}",
        in bytes.(*u8) "{x1}",
        in @len(bytes) "{x2}",
        clobber "memory",
        volatile)
      if result < 0 { return 0, std.error.Error.from_code((-result).(i32)) }
      return result.(usz), std.error.Error.none()
    }
  } else {
    return 0, std.error.Error.io_failed()
  }
}

when OS == .Windows {
  let _get_std_handle(which: i32): *void @foreign(symbol "GetStdHandle")
  let _write_file(
    handle: *void,
    buffer: *u8,
    length: u32,
    written: *mut u32,
    overlapped: *void,
  ): i32 @foreign(symbol "WriteFile")
  let _read_file(
    handle: *void,
    buffer: *mut u8,
    length: u32,
    read: *mut u32,
    overlapped: *void,
  ): i32 @foreign(symbol "ReadFile")
}

pub let mut stdin: ConsoleReader = .{ descriptor=0 }
pub let mut stdout: ConsoleWriter = .{ descriptor=1 }
pub let mut stderr: ConsoleWriter = .{ descriptor=2 }

when TargetHasFilesystem {
import std
import std.alloc
import std.ctypes
import std.libc

pub let FileWriter = type struct {
  handle: *void,
}

pub let FileReader = type struct {
  handle: *void,
}

pub let FileWriter.open(
  path: str,
  append: bool = false,
): (FileWriter, std.error.Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .{ handle=nil }, std.error.Error.out_of_memory() }

  let file = std.libc.fopen(c_path, if append { c"ab" } else { c"wb" })
  let error = if file == nil { std.error.last_error() } else { std.error.Error.none() }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return .{ handle=file.(*void) }, error
}

pub let FileWriter.is_open(*self): bool = self.handle != nil

pub let FileWriter.write(
  *mut self,
  bytes: []u8,
): (usz, std.error.Error) {
  if self.handle == nil { return 0, std.error.Error.invalid_handle() }
  if @len(bytes) == 0 { return 0, std.error.Error.none() }

  let file = self.handle.(*std.libc.FILE)
  let count = std.libc.write(std.libc.fileno(file), bytes.(*u8), @len(bytes))
  if count < 0 { return 0, std.error.last_error() }
  return count.(usz), std.error.Error.none()
}

pub let FileWriter.write_all(
  *mut self,
  bytes: []u8,
): (usz, std.error.Error) {
  let mut written: usz = 0
  for written < @len(bytes) {
    let count, error = self.write(bytes[written:])
    if error.is_error() { return written, error }
    if count == 0 { return written, std.error.Error.no_progress() }
    written += count
  }
  return written, std.error.Error.none()
}

pub let FileWriter.flush(*mut self): std.error.Error {
  if self.handle == nil { return std.error.Error.invalid_handle() }
  if std.libc.fflush(self.handle.(*std.libc.FILE)) != 0 {
    return std.error.last_error()
  }
  return std.error.Error.none()
}

pub let FileWriter.close(*mut self): std.error.Error {
  if self.handle == nil { return std.error.Error.none() }
  let file = self.handle.(*std.libc.FILE)
  self.handle = nil
  if std.libc.fclose(file) != 0 { return std.error.last_error() }
  return std.error.Error.none()
}

pub let FileReader.open(
  path: str,
): (FileReader, std.error.Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .{ handle=nil }, std.error.Error.out_of_memory() }

  let file = std.libc.fopen(c_path, c"rb")
  let error = if file == nil { std.error.last_error() } else { std.error.Error.none() }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return .{ handle=file.(*void) }, error
}

pub let FileReader.is_open(*self): bool = self.handle != nil

pub let FileReader.read(
  *mut self,
  buffer: []mut u8,
): (usz, std.error.Error) {
  if self.handle == nil { return 0, std.error.Error.invalid_handle() }
  if @len(buffer) == 0 { return 0, std.error.Error.none() }

  let count = std.libc.read(
    std.libc.fileno(self.handle.(*std.libc.FILE)),
    buffer.(*mut u8),
    @len(buffer),
  )
  if count < 0 { return 0, std.error.last_error() }
  return count.(usz), std.error.Error.none()
}

pub let FileReader.format(self, writer: *mut dyn Writer): std.error.Error {
  let mut reader = self
  let mut buffer: [4096]u8 = ---

  for true {
    let count, read_error = reader.read(buffer[:])
    if read_error.is_error() { return read_error }
    if count == 0 { return std.error.Error.none() }
    let written, write_error = write_all(writer, buffer[0:count])
    if write_error.is_error() { return write_error }
    if written != count { return std.error.Error.no_progress() }
  }
  return std.error.Error.none()
}

pub let FileReader.close(*mut self): std.error.Error {
  if self.handle == nil { return std.error.Error.none() }
  let file = self.handle.(*std.libc.FILE)
  self.handle = nil
  if std.libc.fclose(file) != 0 { return std.error.last_error() }
  return std.error.Error.none()
}

pub let FileReader.read_line(
  *mut self,
  buffer: []mut u8,
): (usz, std.error.Error) {
  if self.handle == nil { return 0, std.error.Error.invalid_handle() }
  if @len(buffer) == 0 { return 0, std.error.Error.none() }

  let file = self.handle.(*std.libc.FILE)
  let c_buffer = buffer.(*mut u8)
  let line = std.libc.fgets(c_buffer.(*mut std.ctypes.char), @len(buffer).(i32), file)
  if line == nil {
    if std.libc.feof(file) != 0 { return 0, std.error.Error.none() }
    return 0, std.error.last_error()
  }

  let count = std.libc.strnlen(c_buffer, @len(buffer)).(usz)
  return count, std.error.Error.none()
}

}

pub let write_all(
  writer: *mut dyn Writer,
  bytes: []u8,
): (usz, std.error.Error) {
  let mut written: usz = 0
  for written < @len(bytes) {
    let count, error = writer.write(bytes[written:])
    if error.is_error() { return written, error }
    if count == 0 { return written, std.error.Error.no_progress() }
    written += count
  }
  return written, std.error.Error.none()
}
