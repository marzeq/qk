module std.io

import std.strings

pub let Writer = type trait {
  let write(*mut self, bytes: []u8): Result(usz, Error)

  let write_builder(
    *mut self,
    builder: *std.strings.StringBuilder,
  ): Result(usz, Error) = self.write(builder.as_str().([]u8))
}

pub let Reader = type trait {
  let read(*mut self, buffer: []mut u8): Result(usz, Error)

  let read_to_builder(
    *mut self,
    builder: *mut std.strings.StringBuilder,
  ): Result(usz, Error) {
    let mut total: usz = 0
    let mut buffer: [4096]u8 = ---
    for true {
      let count = match self.read(buffer[:]) {
        .Ok(value) => value,
        .Err(error) => { return .Err(error) },
      }
      if count == 0 { return .Ok(total) }
      let written = match builder.write(buffer[0:count]) {
        .Ok(value) => value,
        .Err(error) => { return .Err(error) },
      }
      total += written
      if written != count { return .Err(Error.NoProgress) }
    }
    return .Ok(total)
  }
}

pub let ConsoleWriter = type struct {
  descriptor: i32,
}

pub let ConsoleReader = type struct {
  descriptor: i32,
}

pub let ConsoleReader.read(*mut self, buffer: []mut u8): Result(usz, Error) {
  if @len(buffer) == 0 { return .Ok(0) }
  let buffer_ptr: *mut u8 = buffer[:]

  when OS == .Windows {
    let handle = _get_std_handle(-10)
    if handle == nil { return .Err(Error.InvalidHandle) }
    let mut read: u32 = 0
    let ok = _read_file(
      handle,
      buffer_ptr,
      if @len(buffer) > 4294967295 { 4294967295 } else { @len(buffer).(u32) },
      read.&mut,
      nil,
    )
    if ok == 0 { return .Err(Error.IoFailed) }
    return .Ok(read.(usz))
  } else when Arch == .X86_64 {
    let syscall: u64 =
      when OS == .Linux { 0 }
      else when OS == .MacOS { 33554435 }
      else when OS == .FreeBSD { 3 }
      else when OS == .OpenBSD { 3 }
      else when OS == .NetBSD { 3 }
      else when OS == .DragonFly { 3 }
      else { 0 }
    let result = @asm(
      "syscall",
      out i64 "={rax}",
      in syscall "{rax}",
      in self.descriptor.(i64) "{rdi}",
      in buffer_ptr "{rsi}",
      in @len(buffer) "{rdx}",
      clobber "rcx",
      clobber "r11",
      clobber "memory",
      volatile)
    if result < 0 { return .Err(Error.Native((-result).(i32))) }
    return .Ok(result.(usz))
  } else when Arch == .AArch64 {
    let syscall: u64 =
      when OS == .Linux { 63 }
      else when OS == .MacOS { 33554435 }
      else when OS == .FreeBSD { 3 }
      else when OS == .OpenBSD { 3 }
      else when OS == .NetBSD { 3 }
      else when OS == .DragonFly { 3 }
      else { 0 }
    when OS == .MacOS {
      let result = @asm(
        "svc #0x80",
        out i64 "={x0}",
        in syscall "{x16}",
        in self.descriptor.(i64) "{x0}",
        in buffer_ptr "{x1}",
        in @len(buffer) "{x2}",
        clobber "memory",
        volatile)
      if result < 0 { return .Err(Error.Native((-result).(i32))) }
      return .Ok(result.(usz))
    } else {
      let result = @asm(
        "svc #0",
        out i64 "={x0}",
        in syscall "{x8}",
        in self.descriptor.(i64) "{x0}",
        in buffer_ptr "{x1}",
        in @len(buffer) "{x2}",
        clobber "memory",
        volatile)
      if result < 0 { return .Err(Error.Native((-result).(i32))) }
      return .Ok(result.(usz))
    }
  } else {
    return .Err(Error.IoFailed)
  }
}

pub let ConsoleWriter.write(*mut self, bytes: []u8): Result(usz, Error) {
  if @len(bytes) == 0 { return .Ok(0) }
  let bytes_ptr: *u8 = bytes[:]

  when OS == .Windows {
    let handle = _get_std_handle(if self.descriptor == 1 { -11 } else { -12 })
    if handle == nil { return .Err(Error.InvalidHandle) }
    let mut written: u32 = 0
    let ok = _write_file(
      handle,
      bytes_ptr,
      if @len(bytes) > 4294967295 { 4294967295 } else { @len(bytes).(u32) },
      written.&mut,
      nil,
    )
    if ok == 0 { return .Err(Error.IoFailed) }
    return .Ok(written.(usz))
  } else when Arch == .X86_64 {
    let syscall: u64 =
      when OS == .Linux { 1 }
      else when OS == .MacOS { 33554436 }
      else when OS == .FreeBSD { 4 }
      else when OS == .OpenBSD { 4 }
      else when OS == .NetBSD { 4 }
      else when OS == .DragonFly { 4 }
      else { 0 }
    let result = @asm(
      "syscall",
      out i64 "={rax}",
      in syscall "{rax}",
      in self.descriptor.(i64) "{rdi}",
      in bytes_ptr "{rsi}",
      in @len(bytes) "{rdx}",
      clobber "rcx",
      clobber "r11",
      clobber "memory",
      volatile)
    if result < 0 { return .Err(Error.Native((-result).(i32))) }
    return .Ok(result.(usz))
  } else when Arch == .AArch64 {
    let syscall: u64 =
      when OS == .Linux { 64 }
      else when OS == .MacOS { 33554436 }
      else when OS == .FreeBSD { 4 }
      else when OS == .OpenBSD { 4 }
      else when OS == .NetBSD { 4 }
      else when OS == .DragonFly { 4 }
      else { 0 }
    when OS == .MacOS {
      let result = @asm(
        "svc #0x80",
        out i64 "={x0}",
        in syscall "{x16}",
        in self.descriptor.(i64) "{x0}",
        in bytes_ptr "{x1}",
        in @len(bytes) "{x2}",
        clobber "memory",
        volatile)
      if result < 0 { return .Err(Error.Native((-result).(i32))) }
      return .Ok(result.(usz))
    } else {
      let result = @asm(
        "svc #0",
        out i64 "={x0}",
        in syscall "{x8}",
        in self.descriptor.(i64) "{x0}",
        in bytes_ptr "{x1}",
        in @len(bytes) "{x2}",
        clobber "memory",
        volatile)
      if result < 0 { return .Err(Error.Native((-result).(i32))) }
      return .Ok(result.(usz))
    }
  } else {
    return .Err(Error.IoFailed)
  }
}

when OS == .Windows {
  let _get_std_handle(which: i32): *void @foreign(symbol "GetStdHandle")
  let _write_file(
    handle: *void,
    buffer: *u8,
    length: u32,
    written: *mut u32,
    overlapped: *void,
  ): i32 @foreign(symbol "WriteFile")
  let _read_file(
    handle: *void,
    buffer: *mut u8,
    length: u32,
    read: *mut u32,
    overlapped: *void,
  ): i32 @foreign(symbol "ReadFile")
}

pub let mut stdin: ConsoleReader = .{ descriptor=0 }
pub let mut stdout: ConsoleWriter = .{ descriptor=1 }
pub let mut stderr: ConsoleWriter = .{ descriptor=2 }

when TargetHasFilesystem {
import std
import std.alloc
import std.ctypes
import std.libc
import std.os

pub let FileWriter = type struct {
  handle: *void,
}

pub let FileReader = type struct {
  handle: *void,
}

pub let FileWriter.open(
  path: str,
  append: bool = false,
): Result(FileWriter, Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .Err(Error.OutOfMemory) }

  let file = std.libc.fopen(c_path, if append { c"ab" } else { c"wb" })
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  if file == nil { return .Err(std.os.last_error()) }
  return .Ok(.{ handle=file.(*void) })
}

pub let FileWriter.is_open(*self): bool = self.handle != nil

pub let FileWriter.write(
  *mut self,
  bytes: []u8,
): Result(usz, Error) {
  if self.handle == nil { return .Err(Error.InvalidHandle) }
  if @len(bytes) == 0 { return .Ok(0) }

  let file = self.handle.(*std.libc.FILE)
  let count = std.libc.write(std.libc.fileno(file), bytes[:], @len(bytes))
  if count < 0 { return .Err(std.os.last_error()) }
  return .Ok(count.(usz))
}

pub let FileWriter.write_all(
  *mut self,
  bytes: []u8,
): Result(usz, Error) {
  let mut written: usz = 0
  for written < @len(bytes) {
    let count = match self.write(bytes[written:]) {
      .Ok(value) => value,
      .Err(error) => { return .Err(error) },
    }
    if count == 0 { return .Err(Error.NoProgress) }
    written += count
  }
  return .Ok(written)
}

pub let FileWriter.flush(*mut self): Result(Unit, Error) {
  if self.handle == nil { return .Err(Error.InvalidHandle) }
  if std.libc.fflush(self.handle.(*std.libc.FILE)) != 0 {
    return .Err(std.os.last_error())
  }
  return .Ok(Unit.{})
}

pub let FileWriter.close(*mut self): Result(Unit, Error) {
  if self.handle == nil { return .Ok(Unit.{}) }
  let file = self.handle.(*std.libc.FILE)
  self.handle = nil
  if std.libc.fclose(file) != 0 { return .Err(std.os.last_error()) }
  return .Ok(Unit.{})
}

pub let FileReader.open(
  path: str,
): Result(FileReader, Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .Err(Error.OutOfMemory) }

  let file = std.libc.fopen(c_path, c"rb")
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  if file == nil { return .Err(std.os.last_error()) }
  return .Ok(.{ handle=file.(*void) })
}

pub let FileReader.is_open(*self): bool = self.handle != nil

pub let FileReader.read(
  *mut self,
  buffer: []mut u8,
): Result(usz, Error) {
  if self.handle == nil { return .Err(Error.InvalidHandle) }
  if @len(buffer) == 0 { return .Ok(0) }
  let buffer_ptr: *mut u8 = buffer[:]

  let count = std.libc.read(
    std.libc.fileno(self.handle.(*std.libc.FILE)),
    buffer_ptr,
    @len(buffer),
  )
  if count < 0 { return .Err(std.os.last_error()) }
  return .Ok(count.(usz))
}

pub let FileReader.format(self, writer: *mut dyn Writer): Result(Unit, Error) {
  let mut reader = self
  let mut buffer: [4096]u8 = ---

  for true {
    let count = match reader.read(buffer[:]) {
      .Ok(value) => value,
      .Err(error) => { return .Err(error) },
    }
    if count == 0 { return .Ok(Unit.{}) }
    let written = match write_all(writer, buffer[0:count]) {
      .Ok(value) => value,
      .Err(error) => { return .Err(error) },
    }
    if written != count { return .Err(Error.NoProgress) }
  }
  return .Ok(Unit.{})
}

pub let FileReader.close(*mut self): Result(Unit, Error) {
  if self.handle == nil { return .Ok(Unit.{}) }
  let file = self.handle.(*std.libc.FILE)
  self.handle = nil
  if std.libc.fclose(file) != 0 { return .Err(std.os.last_error()) }
  return .Ok(Unit.{})
}

pub let FileReader.read_line(
  *mut self,
  buffer: []mut u8,
): Result(usz, Error) {
  if self.handle == nil { return .Err(Error.InvalidHandle) }
  if @len(buffer) == 0 { return .Ok(0) }

  let file = self.handle.(*std.libc.FILE)
  let c_buffer: *mut u8 = buffer[:]
  let line = std.libc.fgets(c_buffer.(*mut std.ctypes.char), @len(buffer).(i32), file)
  if line == nil {
    if std.libc.feof(file) != 0 { return .Ok(0) }
    return .Err(std.os.last_error())
  }

  let count = std.libc.strnlen(c_buffer, @len(buffer)).(usz)
  return .Ok(count)
}

}

pub let write_all(
  writer: *mut dyn Writer,
  bytes: []u8,
): Result(usz, Error) {
  let mut written: usz = 0
  for written < @len(bytes) {
    let count = match writer.write(bytes[written:]) {
      .Ok(value) => value,
      .Err(error) => { return .Err(error) },
    }
    if count == 0 { return .Err(Error.NoProgress) }
    written += count
  }
  return .Ok(written)
}
