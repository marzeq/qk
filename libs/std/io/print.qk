module std.io


let write_format_error(writer: *mut dyn Writer): Result(Unit, Error) {
  let error = "<?>".format(writer)
  if error.is_err() { return error }
  return .Err(Error.InvalidData)
}

let format_print_argument(
  writer: *mut dyn Writer,
  index: usz,
  arguments: []*dyn Any,
): Result(Unit, Error) {
  if index >= @len(arguments) { return write_format_error(writer) }
  let formatted, ok = arguments[index].(*dyn Format)
  if !ok { return write_format_error(writer) }
  return formatted.format(writer)
}

let format_character_argument(
  writer: *mut dyn Writer,
  index: usz,
  arguments: []*dyn Any,
): Result(Unit, Error) {
  if index >= @len(arguments) { return write_format_error(writer) }
  let character, ok = arguments[index].(u8)
  if !ok { return write_format_error(writer) }
  return write_byte(writer, character)
}

let format_hex_value(
  writer: *mut dyn Writer,
  value: u64,
  uppercase: bool,
): Result(Unit, Error) {
  let digits = if uppercase { "0123456789ABCDEF" } else { "0123456789abcdef" }
  let mut buffer: [16]u8 = ---
  let mut cursor = @len(buffer)
  let mut remaining = value
  for true {
    cursor -= 1
    buffer[cursor] = digits[(remaining & 0xf).(usz)]
    remaining >>= 4
    if remaining == 0 { break }
  }
  return write_bytes(writer, buffer[cursor:])
}

let format_hex_argument(
  writer: *mut dyn Writer,
  index: usz,
  arguments: []*dyn Any,
  uppercase: bool,
): Result(Unit, Error) {
  if index >= @len(arguments) { return write_format_error(writer) }
  let argument = arguments[index]
  let value_u8, is_u8 = argument.(u8)
  if is_u8 { return format_hex_value(writer, value_u8.(u64), uppercase) }
  let value_u16, is_u16 = argument.(u16)
  if is_u16 { return format_hex_value(writer, value_u16.(u64), uppercase) }
  let value_u32, is_u32 = argument.(u32)
  if is_u32 { return format_hex_value(writer, value_u32.(u64), uppercase) }
  let value_u64, is_u64 = argument.(u64)
  if is_u64 { return format_hex_value(writer, value_u64, uppercase) }
  let value_usz, is_usz = argument.(usz)
  if is_usz { return format_hex_value(writer, value_usz.(u64), uppercase) }
  return write_format_error(writer)
}

let format_general_float_argument(
  writer: *mut dyn Writer,
  index: usz,
  arguments: []*dyn Any,
): Result(Unit, Error) {
  if index >= @len(arguments) { return write_format_error(writer) }
  let value_f32, is_f32 = arguments[index].(f32)
  if is_f32 { return write_f64_general(writer, value_f32.(f64)) }
  let value_f64, is_f64 = arguments[index].(f64)
  if is_f64 { return write_f64_general(writer, value_f64) }
  return write_format_error(writer)
}

let format_specified_argument(
  writer: *mut dyn Writer,
  index: usz,
  specifier: u8,
  arguments: []*dyn Any,
): Result(Unit, Error) {
  if specifier == 'g' { return format_general_float_argument(writer, index, arguments) }
  if specifier == 'c' { return format_character_argument(writer, index, arguments) }
  if specifier == 'x' { return format_hex_argument(writer, index, arguments, false) }
  if specifier == 'X' { return format_hex_argument(writer, index, arguments, true) }
  return write_format_error(writer)
}

pub let wprint(
  writer: *mut dyn Writer,
  format: str,
  arguments: ...*dyn Any
): Result(Unit, Error) {
  let mut format_index: usz = 0
  let mut argument_index: usz = 0

  for format_index < @len(format) {
    let character = format[format_index]
    if character == '}' && format_index + 1 < @len(format) && format[format_index + 1] == '}' {
      let error = write_byte(writer, '}')
      if error.is_err() { return error }
      format_index += 2
      continue
    }
    if character != '{' {
      let error = write_byte(writer, character)
      if error.is_err() { return error }
      format_index += 1
      continue
    }
    if format_index + 1 >= @len(format) {
      return write_byte(writer, '{')
    }
    if format[format_index + 1] == '{' {
      let error = write_byte(writer, '{')
      if error.is_err() { return error }
      format_index += 2
      continue
    }
    if format[format_index + 1] == '}' {
      let error = format_print_argument(writer, argument_index, arguments)
      if error.is_err() { return error }
      argument_index += 1
      format_index += 2
      continue
    }
    if format_index + 2 < @len(format) && format[format_index + 2] == '}' {
      let specifier = format[format_index + 1]
      if specifier == 'g' || specifier == 'c' || specifier == 'x' || specifier == 'X' {
        let error = format_specified_argument(writer, argument_index, specifier, arguments)
        if error.is_err() { return error }
        argument_index += 1
        format_index += 3
        continue
      }
    }
    if format_index + 3 < @len(format) && format[format_index + 1] == ':' && format[format_index + 3] == '}' {
      let specifier = format[format_index + 2]
      if specifier == 'g' || specifier == 'c' || specifier == 'x' || specifier == 'X' {
        let error = format_specified_argument(writer, argument_index, specifier, arguments)
        if error.is_err() { return error }
        argument_index += 1
        format_index += 4
        continue
      }
    }

    let mut cursor = format_index + 1
    let mut selected: usz = 0
    let mut has_digit = false
    for cursor < @len(format) && format[cursor] >= '0' && format[cursor] <= '9' {
      has_digit = true
      selected = selected * 10 + (format[cursor] - '0').(usz)
      cursor += 1
    }
    if has_digit && cursor < @len(format) {
      if format[cursor] == '}' {
        let error = format_print_argument(writer, selected, arguments)
        if error.is_err() { return error }
        argument_index = selected + 1
        format_index = cursor + 1
        continue
      }
      if cursor + 2 < @len(format) && format[cursor] == ':' && format[cursor + 2] == '}' {
        let specifier = format[cursor + 1]
        if specifier == 'g' || specifier == 'c' || specifier == 'x' || specifier == 'X' {
          let error = format_specified_argument(writer, selected, specifier, arguments)
          if error.is_err() { return error }
          argument_index = selected + 1
          format_index = cursor + 3
          continue
        }
      }
    }

    let error = write_byte(writer, '{')
    if error.is_err() { return error }
    format_index += 1
  }
  return .Ok(Unit.{})
}

pub let wprintln(
  writer: *mut dyn Writer,
  format: str,
  arguments: ...*dyn Any
): Result(Unit, Error) {
  let error = wprint(writer, format, arguments...)
  if error.is_err() { return error }
  return write_byte(writer, '\n')
}

pub let print(format: str, arguments: ...*dyn Any): Result(Unit, Error) =
  wprint(stdout.&mut.(*mut dyn Writer), format, arguments...)

pub let println(format: str, arguments: ...*dyn Any): Result(Unit, Error) =
  wprintln(stdout.&mut.(*mut dyn Writer), format, arguments...)

when TargetHasFilesystem {
  pub let fprint(
    file: *mut FileWriter,
    format: str,
    arguments: ...*dyn Any
  ): Result(Unit, Error) = wprint(file.(*mut dyn Writer), format, arguments...)

  pub let fprintln(
    file: *mut FileWriter,
    format: str,
    arguments: ...*dyn Any
  ): Result(Unit, Error) = wprintln(file.(*mut dyn Writer), format, arguments...)
}

pub let eprint(format: str, arguments: ...*dyn Any): Result(Unit, Error) =
  wprint(stderr.&mut.(*mut dyn Writer), format, arguments...)

pub let eprintln(format: str, arguments: ...*dyn Any): Result(Unit, Error) =
  wprintln(stderr.&mut.(*mut dyn Writer), format, arguments...)
