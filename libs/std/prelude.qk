module std

import std.os

pub let Add = type trait {
  let add(self, other: Self): Self
}

pub let Sub = type trait {
  let sub(self, other: Self): Self
}

pub let Mul = type trait {
  let mul(self, other: Self): Self
}

pub let Div = type trait {
  let div(self, other: Self): Self
}

pub let Rem = type trait {
  let rem(self, other: Self): Self
}

pub let Neg = type trait {
  let neg(self): Self
}

pub let PartialEq = type trait {
  let eq(self, other: Self): bool
}

pub let PartialOrd = type trait {
  let lt(self, other: Self): bool
  let le(self, other: Self): bool
  let gt(self, other: Self): bool
  let ge(self, other: Self): bool
}

pub let BitAnd = type trait {
  let bit_and(self, other: Self): Self
}

pub let BitOr = type trait {
  let bit_or(self, other: Self): Self
}

pub let BitXor = type trait {
  let bit_xor(self, other: Self): Self
}

pub let Shl = type trait {
  let shl(self, other: Self): Self
}

pub let Shr = type trait {
  let shr(self, other: Self): Self
}

pub let BitNot = type trait {
  let bit_not(self): Self
}

