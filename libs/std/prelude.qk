pub let i8.eq(self, other: i8): bool = self == other
pub let i16.eq(self, other: i16): bool = self == other
pub let i32.eq(self, other: i32): bool = self == other
pub let i64.eq(self, other: i64): bool = self == other
pub let isz.eq(self, other: isz): bool = self == other
pub let u8.eq(self, other: u8): bool = self == other
pub let u16.eq(self, other: u16): bool = self == other
pub let u32.eq(self, other: u32): bool = self == other
pub let u64.eq(self, other: u64): bool = self == other
pub let usz.eq(self, other: usz): bool = self == other
pub let f32.eq(self, other: f32): bool = self == other
pub let f64.eq(self, other: f64): bool = self == other
pub let bool.eq(self, other: bool): bool = self == other

pub let cstr.eq(self, other: cstr): bool {
  let mut index: usz = 0
  for self[index] != '\0' && other[index] != '\0' {
    if self[index] != other[index] {
      return false
    }
    index += 1
  }
  return self[index] == other[index]
}

pub let str.eq(self, other: str): bool {
  if @len(self) != @len(other) {
    return false
  }
  let mut index: usz = 0
  for index < @len(self) {
    if self[index] != other[index] {
      return false
    }
    index += 1
  }
  return true
}

