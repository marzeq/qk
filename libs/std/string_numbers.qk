module std

// Parse the entire string. Bases from 2 through 36 are accepted; overflow is an error.
let integer_digit(value: u8): (u8, bool) {
  if value >= '0' && value <= '9' { return value - '0', true }
  if value >= 'a' && value <= 'z' { return value - 'a' + 10, true }
  if value >= 'A' && value <= 'Z' { return value - 'A' + 10, true }
  return 0, false
}

pub let str.to_u64(self, base: u8 = 10): (u64, bool) {
  if len(self) == 0 || base < 2 || base > 36 { return 0, false }

  let radix = base.(u64)
  let mut result: u64 = 0
  let mut index: usz = 0
  for index < len(self) {
    let digit, valid = integer_digit(self[index])
    if !valid || digit >= base { return 0, false }
    if result > ((~0.(u64)) - digit.(u64)) / radix { return 0, false }
    result = result * radix + digit.(u64)
    index += 1
  }
  return result, true
}

pub let str.to_i64(self, base: u8 = 10): (i64, bool) {
  if len(self) == 0 { return 0, false }
  let negative = self[0] == '-'
  let start: usz = if negative || self[0] == '+' { 1 } else { 0 }
  if start == len(self) { return 0, false }

  let magnitude, valid = self[start:].to_u64(base)
  if !valid { return 0, false }
  let positive_limit = 9223372036854775807.(u64)
  if negative {
    if magnitude > positive_limit + 1 { return 0, false }
    if magnitude == positive_limit + 1 { return (~9223372036854775807.(i64)), true }
    return -magnitude.(i64), true
  }
  if magnitude > positive_limit { return 0, false }
  return magnitude.(i64), true
}

pub let str.to_u8(self, base: u8 = 10): (u8, bool) {
  let value, ok = self.to_u64(base)
  if !ok || value > 255 { return 0, false }
  return value.(u8), true
}

pub let str.to_u16(self, base: u8 = 10): (u16, bool) {
  let value, ok = self.to_u64(base)
  if !ok || value > 65535 { return 0, false }
  return value.(u16), true
}

pub let str.to_u32(self, base: u8 = 10): (u32, bool) {
  let value, ok = self.to_u64(base)
  if !ok || value > 4294967295 { return 0, false }
  return value.(u32), true
}

pub let str.to_i8(self, base: u8 = 10): (i8, bool) {
  let value, ok = self.to_i64(base)
  if !ok || value < -128 || value > 127 { return 0, false }
  return value.(i8), true
}

pub let str.to_i16(self, base: u8 = 10): (i16, bool) {
  let value, ok = self.to_i64(base)
  if !ok || value < -32768 || value > 32767 { return 0, false }
  return value.(i16), true
}

pub let str.to_i32(self, base: u8 = 10): (i32, bool) {
  let value, ok = self.to_i64(base)
  if !ok || value < -2147483648 || value > 2147483647 { return 0, false }
  return value.(i32), true
}

pub let str.to_usz(self, base: u8 = 10): (usz, bool) {
  let value, ok = self.to_u64(base)
  if !ok || (sizeof(usz) == 4 && value > 4294967295) { return 0, false }
  return value.(usz), true
}

pub let str.to_isz(self, base: u8 = 10): (isz, bool) {
  let value, ok = self.to_i64(base)
  if !ok || (sizeof(isz) == 4 && (value < -2147483648 || value > 2147483647)) { return 0, false }
  return value.(isz), true
}

// A null C string has no integer value.
pub let cstr.to_u8(self, base: u8 = 10): (u8, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_u8(base)
}

pub let cstr.to_u16(self, base: u8 = 10): (u16, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_u16(base)
}

pub let cstr.to_u32(self, base: u8 = 10): (u32, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_u32(base)
}

pub let cstr.to_u64(self, base: u8 = 10): (u64, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_u64(base)
}

pub let cstr.to_usz(self, base: u8 = 10): (usz, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_usz(base)
}

pub let cstr.to_i8(self, base: u8 = 10): (i8, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_i8(base)
}

pub let cstr.to_i16(self, base: u8 = 10): (i16, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_i16(base)
}

pub let cstr.to_i32(self, base: u8 = 10): (i32, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_i32(base)
}

pub let cstr.to_i64(self, base: u8 = 10): (i64, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_i64(base)
}

pub let cstr.to_isz(self, base: u8 = 10): (isz, bool) {
  if self == nil { return 0, false }
  return self.to_str().to_isz(base)
}
