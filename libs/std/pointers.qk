module std

pub let (*$T).is_nil(self): bool = self == nil

pub let (*mut $T).as_const(self): *T = self

pub let (*$T).as_slice(self, length: usz): []T {
  if self == nil { return self[:0] }
  return self[:length]
}

pub let (*mut $T).as_slice(self, length: usz): []mut T {
  if self == nil { return self[:0] }
  return self[:length]
}
