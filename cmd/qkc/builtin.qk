module builtin

pub let Unit = struct {}

pub let Error = union(@auto) {
  OutOfMemory,
  InvalidHandle,
  NoProgress,
  InvalidData,
  OutOfRange,
  IoFailed,
  NotFound,
  Native(i32),
  Message(str),


  pub let message(self): str = match self {
    .OutOfMemory => "out of memory",
    .InvalidHandle => "invalid handle",
    .NoProgress => "operation made no progress",
    .InvalidData => "invalid data",
    .OutOfRange => "value out of range",
    .IoFailed => "input/output operation failed",
    .NotFound => "not found",
    .Native(_) => "native error",
    .Message(message) => message,
  }

  pub let native_code(self): Option(i32) = match self {
    .Native(code) => .Some(code),
    _ => .None,
  }
}


pub let Option($T: type) = union(@auto) {
  Some(T),
  None,


  pub let is_some(self): bool = match self {
    .Some(_) => true,
    .None => false,
  }

  pub let is_none(self): bool = !self.is_some()

  pub let as_ref(*self): Option(*T) = match self.* {
    .Some(value) => .Some(value.&),
    .None => .None,
  }

  pub let expect(self, message: str): T = match self {
    .Some(value) => value,
    .None => { panic(message) },
  }

  pub let unwrap(self): T = self.expect("called Option.unwrap on None")

  pub let unwrap_or(self, fallback: T): T = match self {
    .Some(value) => value,
    .None => fallback,
  }

  pub let unwrap_or_else(self, fallback: *(): T): T = match self {
    .Some(value) => value,
    .None => fallback(),
  }

  pub let map(self, $U: type, transform: *(T): U): Option(U) = match self {
    .Some(value) => Option(U).Some(transform(value)),
    .None => Option(U).None,
  }

  pub let map_or(self, $U: type, fallback: U, transform: *(T): U): U = match self {
    .Some(value) => transform(value),
    .None => fallback,
  }

  pub let map_or_else(
    self,
    $U: type,
    fallback: *(): U,
    transform: *(T): U,
  ): U = match self {
    .Some(value) => transform(value),
    .None => fallback(),
  }

  pub let and_then(self, $U: type, transform: *(T): Option(U)): Option(U) = match self {
    .Some(value) => transform(value),
    .None => Option(U).None,
  }

  pub let filter(self, predicate: *(T): bool): Option(T) = match self {
    .Some(value) => if predicate(value) { self } else { Option(T).None },
    .None => self,
  }

  pub let inspect(self, inspect: *(T): void): Option(T) = match self {
    .Some(value) => { inspect(value); self },
    .None => self,
  }

  pub let or(self, fallback: Option(T)): Option(T) = match self {
    .Some(_) => self,
    .None => fallback,
  }

  pub let or_else(self, fallback: *(): Option(T)): Option(T) = match self {
    .Some(_) => self,
    .None => fallback(),
  }

  pub let xor(self, other: Option(T)): Option(T) = match self, other {
    .Some(_), .None => self,
    .None, .Some(_) => other,
    _ => Option(T).None,
  }

  pub let ok_or(self, $E: type, error: E): Result(T, E) = match self {
    .Some(value) => Result(T, E).Ok(value),
    .None => Result(T, E).Err(error),
  }

  pub let ok_or_else(self, $E: type, error: *(): E): Result(T, E) = match self {
    .Some(value) => Result(T, E).Ok(value),
    .None => Result(T, E).Err(error()),
  }
}

pub let Result($T: type, $E: type) = union(@auto) {
  Ok(T),
  Err(E),


  pub let is_ok(self): bool = match self {
    .Ok(_) => true,
    .Err(_) => false,
  }

  pub let is_err(self): bool = !self.is_ok()

  pub let as_ref(*self): Result(*T, *E) = match self.* {
    .Ok(value) => .Ok(value.&),
    .Err(error) => .Err(error.&),
  }

  pub let ok(self): Option(T) = match self {
    .Ok(value) => Option(T).Some(value),
    .Err(_) => Option(T).None,
  }

  pub let err(self): Option(E) = match self {
    .Ok(_) => Option(E).None,
    .Err(error) => Option(E).Some(error),
  }

  pub let expect(self, message: str): T = match self {
    .Ok(value) => value,
    .Err(_) => { panic(message) },
  }

  pub let unwrap(self): T = self.expect("called Result.unwrap on Err")

  pub let expect_err(self, message: str): E = match self {
    .Ok(_) => { panic(message) },
    .Err(error) => error,
  }

  pub let unwrap_err(self): E = self.expect_err("called Result.unwrap_err on Ok")

  pub let unwrap_or(self, fallback: T): T = match self {
    .Ok(value) => value,
    .Err(_) => fallback,
  }

  pub let unwrap_or_else(self, fallback: *(E): T): T = match self {
    .Ok(value) => value,
    .Err(error) => fallback(error),
  }

  pub let map(self, $U: type, transform: *(T): U): Result(U, E) = match self {
    .Ok(value) => Result(U, E).Ok(transform(value)),
    .Err(error) => Result(U, E).Err(error),
  }

  pub let map_or(self, $U: type, fallback: U, transform: *(T): U): U = match self {
    .Ok(value) => transform(value),
    .Err(_) => fallback,
  }

  pub let map_or_else(
    self,
    $U: type,
    fallback: *(E): U,
    transform: *(T): U,
  ): U = match self {
    .Ok(value) => transform(value),
    .Err(error) => fallback(error),
  }

  pub let map_err(self, $F: type, transform: *(E): F): Result(T, F) = match self {
    .Ok(value) => Result(T, F).Ok(value),
    .Err(error) => Result(T, F).Err(transform(error)),
  }

  pub let inspect(self, inspect: *(T): void): Result(T, E) = match self {
    .Ok(value) => { inspect(value); self },
    .Err(_) => self,
  }

  pub let inspect_err(self, inspect: *(E): void): Result(T, E) = match self {
    .Ok(_) => self,
    .Err(error) => { inspect(error); self },
  }

  pub let and_then(self, $U: type, transform: *(T): Result(U, E)): Result(U, E) = match self {
    .Ok(value) => transform(value),
    .Err(error) => Result(U, E).Err(error),
  }

  pub let or(self, $F: type, fallback: Result(T, F)): Result(T, F) = match self {
    .Ok(value) => Result(T, F).Ok(value),
    .Err(_) => fallback,
  }

  pub let or_else(self, $F: type, fallback: *(E): Result(T, F)): Result(T, F) = match self {
    .Ok(value) => Result(T, F).Ok(value),
    .Err(error) => fallback(error),
  }
}
