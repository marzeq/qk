module main

import std.io

let add_digit(value: *mut i32, digit: i32): void {
  value.* = value.* * 10 + digit
}

let deferred(value: *mut i32): void {
  defer add_digit(value, 3)
  defer add_digit(value, 2)
  add_digit(value, 1)
}

let main() {
  let selected: i32 = if true { 4 } else { 9 }
  let block: i32 = { let base: i32 = 3; base * 2 }
  assert(selected == 4 && block == 6, "expression control flow")

  let mut sum: i32 = 0
  for let mut index: i32 = 0; index < 6; index += 1 {
    if index == 1 { continue }
    if index == 5 { break }
    sum += index
  }
  for value in 1..=3 { sum += value.(i32) }
  let values: [3]i32 = [1, 2, 3]
  for value, index in values @reversed { sum += value * (index + 1).(i32) }
  assert(sum == 29, "loops")

  let mut order: i32 = 0
  deferred(order.&mut)
  assert(order == 123, "defer order")
  std.io.println("control flow ok")
}
