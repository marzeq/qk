module main

import std.io

let Counter = struct {
  value: i32,

  let init(value: i32): Counter = .{ value=value }
  let get(self): i32 = self.value
  let read(*self): i32 = self.value
  let increment(*mut self): void { self.value += 1 }
}

let main() {
  let mut counter = Counter.init(10)
  counter.increment()
  assert(counter.get() == 11, "value receiver")
  assert(counter.read() == 11, "pointer receiver adjustment")
  std.io.println("methods ok")
}
