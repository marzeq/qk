{
  "mode": "cache-sequence",
  "cacheSequence": [
    {
      "name": "cold build",
      "compilerArgs": ["-v"],
      "stdout": ""
    },
    {
      "name": "exact warm manifest",
      "compilerArgs": ["-v"],
      "stdoutContains": ["used cached QK modules from <CASE>/.cache/qk/modules/"]
    },
    {
      "name": "whitespace edit reuses object",
      "compilerArgs": ["-v"],
      "files": {
        "main.qk": "module main\n\n\nlet main() { assert(true, \"cache\") }\n"
      },
      "stdoutContains": ["used cached object for module ."]
    },
    {
      "name": "release selects frontend variant",
      "compilerArgs": ["-v", "-release"],
      "stdoutNotContains": ["used cached QK modules from"]
    },
    {
      "name": "release warm manifest",
      "compilerArgs": ["-v", "-release"],
      "stdoutContains": ["used cached QK modules from <CASE>/.cache/qk/modules/"]
    },
    {
      "name": "optimization changes object variant",
      "compilerArgs": ["-v", "-release", "-O0"],
      "stdoutContains": ["used cached QK modules from <CASE>/.cache/qk/modules/"],
      "stdoutNotContains": ["used cached object for module ."]
    }
  ]
}
