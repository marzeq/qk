module main

import std.io
import std.collections

let Point = type struct { x: i32, y: i32 }
let Direction = type enum { North, East, South, West }
let Permission = type flags(u8) { Read, Write, Execute }
let Result = type union(@auto) { Ok(i32), Error(message: str), Cancelled }
let RecursiveChildren = type alias std.collections.DynamicArray<Recursive>
let Recursive = type union(@auto) { Leaf, Branch(children: RecursiveChildren) }
let ARecursiveList = type struct { items: std.collections.DynamicArray<BRecursiveItem> }
let BRecursiveItem = type struct { parents: CRecursiveParents }
let CRecursiveParents = type alias std.collections.DynamicArray<DRecursiveParent>
let DRecursiveParent = type union(@auto) { List(ARecursiveList) }

let result_value(result: Result): i32 = match result {
  .Ok(value) => { value }
  .Error(message=text) => { @len(text).(i32) }
  .Cancelled => { -1 }
}

let results_equal(left: Result, right: Result): bool = match left, right {
  .Ok(left_value), .Ok(right_value) => left_value == right_value,
  .Error(message=left_text), .Error(message=right_text) => @len(left_text) == @len(right_text),
  .Cancelled, .Cancelled => true,
  _ => false,
}

let bool_pair_code(left: bool, right: bool): i32 = match left, right {
  true, true => 0,
  true, false => 1,
  false, true => 2,
  false, false => 3,
}

let main() {
  let mut point = Point.{ x=2, y=3 }
  let pointer = point.&mut
  pointer.x += 4
  let array: [4]i32 = [1, 2, 3, 4]
  let slice: []i32 = array[1:3]
  let direction: Direction = .East
  let mut permissions = Permission.{ .Read, .Write }
  permissions.Write = false
  let result = Result.Ok(42)
  let recursive = Recursive.Leaf
  match direction {
    .North => { assert(false, "wrong direction") }
    .East => { assert(true, "right direction") }
    .South | .West => {}
  }
  assert(point.x == 6 && pointer.y == 3, "struct and pointer")
  assert(@len(array) == 4 && @len(slice) == 2 && slice[0] == 2, "arrays and slices")
  assert(direction == .East && permissions.Read && !permissions.Write, "enum and flags")
  assert(result_value(result) == 42, "tagged union")
  assert(results_equal(result, Result.Ok(42)), "multi-subject match equal")
  assert(!results_equal(result, Result.Cancelled), "multi-subject match fallback")
  assert(bool_pair_code(false, true) == 2, "exhaustive multi-subject match")
  let _ = recursive
  std.io.println("types ok")
}
