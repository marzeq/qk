module main

import std.io

let Point = type struct { x: i32, y: i32 }
let Direction = type enum { North, East, South, West }
let Permission = type flags(u8) { Read, Write, Execute }
let Result = type union(@auto) { Ok(i32), Error(message: str), Cancelled }

let result_value(result: Result): i32 = match result {
  .Ok(value) => value,
  .Error(message=text) => @len(text).(i32),
  .Cancelled => -1,
}

let main() {
  let mut point = Point.{ x=2, y=3 }
  let pointer = point.&mut
  pointer.x += 4
  let array: [4]i32 = [1, 2, 3, 4]
  let slice: []i32 = array[1:3]
  let direction: Direction = .East
  let mut permissions = Permission.{ .Read, .Write }
  permissions.Write = false
  let result = Result.Ok(42)
  assert(point.x == 6 && pointer.y == 3, "struct and pointer")
  assert(@len(array) == 4 && @len(slice) == 2 && slice[0] == 2, "arrays and slices")
  assert(direction == .East && permissions.Read && !permissions.Write, "enum and flags")
  assert(result_value(result) == 42, "tagged union")
  std.io.println("types ok")
}
