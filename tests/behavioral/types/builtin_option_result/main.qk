module main

let increment(value: i32): i32 = value + 1
let is_positive(value: i32): bool = value > 0
let fallback(): i32 = 7
let stringify_error(value: i32): i64 = value.(i64)
let positive(value: i32): Result(i32, str) = if value > 0 {
  .Ok(value)
} else {
  .Err("not positive")
}

let main() {
  let some = Option(i32).Some(4)
  let none = Option(i32).None
  assert(some.is_some() && none.is_none(), "option state")
  assert(some.unwrap() == 4, "option unwrap")
  assert(none.unwrap_or(6) == 6, "option unwrap_or")
  assert(none.unwrap_or_else(fallback) == 7, "option unwrap_or_else")
  assert(some.map(increment).unwrap() == 5, "option map")
  assert(some.filter(is_positive).is_some(), "option filter")
  assert(some.xor(none).unwrap() == 4, "option xor")
  assert(some.ok_or("missing").unwrap() == 4, "option ok_or")

  let ok: Result(i32, i32) = .Ok(8)
  let err: Result(i32, i32) = .Err(3)
  assert(ok.is_ok() && err.is_err(), "result state")
  assert(ok.ok().unwrap() == 8, "result ok")
  assert(err.err().unwrap() == 3, "result err")
  assert(ok.map(increment).unwrap() == 9, "result map")
  assert(err.map_err(stringify_error).unwrap_err() == 3, "result map_err")
  assert(positive(2).and_then(positive).unwrap() == 2, "result and_then")
}
