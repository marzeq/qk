module main

import std.io

let main() {
  std.io.println("plain")
  std.io.println("escaped {{brace}}")
  std.io.println("literal {q}")
  let dynamic: str = "runtime {{brace}}"
  std.io.println(dynamic)
  let missing = std.io.println("missing {}")
  assert(missing.is_err(), "missing format argument")
  std.io.println("done")
  let number: i32 = 42
  std.io.println("number {}", number)
}
