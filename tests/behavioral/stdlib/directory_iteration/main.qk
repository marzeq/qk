module main

import std.alloc
import std.fs
import std.io
import std.strings

let main() {
  let mut missing, missing_error = std.fs.DirectoryIterator.open("testdata/directory/missing")
  assert(missing_error.is_error(), "missing directory open")
  assert(missing.close().is_none(), "close failed open")

  let mut file, file_error = std.fs.DirectoryIterator.open("testdata/directory/alpha.txt")
  assert(file_error.is_error(), "file opened as directory")
  assert(file.close().is_none(), "close rejected file open")

  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let mut name = std.strings.StringBuilder.init(allocator)
  defer name.deinit()
  let format_error = std.io.wprint(
    name.&mut.(*mut dyn std.io.Writer),
    "{}",
    std.fs.DirectoryEntryKind.Directory,
  )
  assert(format_error.is_none() && name.as_str().eq("Directory"), "entry kind format")
  name.clear()

  assert(std.fs.create_directory("empty-directory").is_none(), "create empty directory")
  let mut empty, empty_error = std.fs.DirectoryIterator.open("empty-directory")
  assert(empty_error.is_none(), "empty directory open")
  assert(name.append("stale entry name".([]u8)), "prepare stale name")
  let empty_kind, empty_found, empty_next_error = empty.next(name.&mut)
  assert(
    empty_kind == .Unknown && !empty_found && empty_next_error.is_none(),
    "empty directory exhaustion",
  )
  assert(@len(name.as_str()) == 0, "exhaustion clears builder")
  let repeated_kind, repeated_found, repeated_error = empty.next(name.&mut)
  assert(
    repeated_kind == .Unknown && !repeated_found && repeated_error.is_none(),
    "exhaustion is sticky",
  )
  assert(empty.close().is_none(), "close after exhaustion")
  assert(empty.close().is_none(), "double close")
  assert(std.fs.remove_directory("empty-directory").is_none(), "remove empty directory")
  let _, closed_found, closed_error = empty.next(name.&mut)
  assert(!closed_found && closed_error.is_error(), "next after close")

  let mut iterator, open_error = std.fs.DirectoryIterator.open("testdata/directory")
  assert(open_error.is_none(), "directory open")
  let mut saw_alpha = false
  let mut saw_hidden = false
  let mut saw_nested = false
  let mut count: usz = 0
  for true {
    assert(name.append("a much longer stale entry name".([]u8)), "prepare reused builder")
    let kind, found, next_error = iterator.next(name.&mut)
    assert(next_error.is_none(), "directory enumeration error")
    if !found {
      assert(kind == .Unknown && @len(name.as_str()) == 0, "exhaustion convention")
      break
    }

    let entry_name = name.as_str()
    assert(!entry_name.eq(".") && !entry_name.eq(".."), "synthetic entry returned")
    assert(!entry_name.eq("beta.txt"), "iteration recursed")
    if entry_name.eq("alpha.txt") {
      assert(!saw_alpha, "duplicate alpha")
      assert(kind == .File || kind == .Unknown, "alpha kind")
      saw_alpha = true
    } else if entry_name.eq(".hidden") {
      assert(!saw_hidden, "duplicate hidden")
      assert(kind == .File || kind == .Unknown, "hidden kind")
      saw_hidden = true
    } else if entry_name.eq("nested") {
      assert(!saw_nested, "duplicate nested")
      assert(kind == .Directory || kind == .Unknown, "nested kind")
      saw_nested = true
    } else {
      assert(false, "unexpected directory entry")
    }
    count += 1
  }
  assert(count == 3 && saw_alpha && saw_hidden && saw_nested, "entry set")
  assert(iterator.close().is_none(), "close enumerated directory")

  let mut early, early_error = std.fs.DirectoryIterator.open("testdata/directory")
  assert(early_error.is_none(), "early-close open")
  assert(early.close().is_none(), "close before exhaustion")
}
