module main

import std.alloc
import std.fs
import std.io
import std.strings

let main() {
  let missing = std.fs.DirectoryIterator.open("testdata/directory/missing")
  assert(missing.is_err(), "missing directory open")

  let file = std.fs.DirectoryIterator.open("testdata/directory/alpha.txt")
  assert(file.is_err(), "file opened as directory")

  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let mut name = std.strings.StringBuilder.init(allocator)
  defer name.deinit()
  let format_error = std.io.wprint(
    name.&mut.(*mut dyn std.io.Writer),
    "{}",
    std.fs.DirectoryEntryKind.Directory,
  )
  assert(format_error.is_ok() && name.as_str().eq("Directory"), "entry kind format")
  name.clear()

  assert(std.fs.create_directory("empty-directory").is_ok(), "create empty directory")
  let mut empty = std.fs.DirectoryIterator.open("empty-directory").unwrap()
  assert(name.append("stale entry name".([]u8)), "prepare stale name")
  assert(empty.next(name.&mut).unwrap().is_none(), "empty directory exhaustion")
  assert(@len(name.as_str()) == 0, "exhaustion clears builder")
  assert(empty.next(name.&mut).unwrap().is_none(), "exhaustion is sticky")
  assert(empty.close().is_ok(), "close after exhaustion")
  assert(empty.close().is_ok(), "double close")
  assert(std.fs.remove_directory("empty-directory").is_ok(), "remove empty directory")
  assert(empty.next(name.&mut).is_err(), "next after close")

  let mut iterator = std.fs.DirectoryIterator.open("testdata/directory").unwrap()
  let mut saw_alpha = false
  let mut saw_hidden = false
  let mut saw_nested = false
  let mut count: usz = 0
  for true {
    assert(name.append("a much longer stale entry name".([]u8)), "prepare reused builder")
    let next = iterator.next(name.&mut).unwrap()
    if next.is_none() {
      assert(@len(name.as_str()) == 0, "exhaustion convention")
      break
    }
    let kind = next.unwrap()

    let entry_name = name.as_str()
    assert(!entry_name.eq(".") && !entry_name.eq(".."), "synthetic entry returned")
    assert(!entry_name.eq("beta.txt"), "iteration recursed")
    if entry_name.eq("alpha.txt") {
      assert(!saw_alpha, "duplicate alpha")
      assert(kind == .File || kind == .Unknown, "alpha kind")
      saw_alpha = true
    } else if entry_name.eq(".hidden") {
      assert(!saw_hidden, "duplicate hidden")
      assert(kind == .File || kind == .Unknown, "hidden kind")
      saw_hidden = true
    } else if entry_name.eq("nested") {
      assert(!saw_nested, "duplicate nested")
      assert(kind == .Directory || kind == .Unknown, "nested kind")
      saw_nested = true
    } else {
      assert(false, "unexpected directory entry")
    }
    count += 1
  }
  assert(count == 3 && saw_alpha && saw_hidden && saw_nested, "entry set")
  assert(iterator.close().is_ok(), "close enumerated directory")

  let mut early = std.fs.DirectoryIterator.open("testdata/directory").unwrap()
  assert(early.close().is_ok(), "close before exhaustion")
}
