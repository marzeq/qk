module main

import (
  std.alloc
  std.io
  std.math
  std.random
  std.strings
  std.time
)

let main() {
  let text = "  hello world  "
  assert(text.trim().eq("hello world"), "trim")
  assert(text.contains("world") && text.starts_with("  he") && text.ends_with("d  "), "string search")
  let index, found = text.find("hello")
  assert(found && index == 2, "string find")

  let mut values: [4]i32 = [1, 2, 3, 4]
  let slice: []mut i32 = values[:]
  slice.reverse()
  assert(slice[0] == 4 && slice.contains(2), "slice utilities")

  let mut random = std.random.Random.init(12345)
  let sampled = random.range(10, 20)
  assert(sampled >= 10 && sampled < 20, "random bounds")
  assert(std.math.abs(-3.5) == 3.5, "math abs")
  let root = std.math.sqrt(9.0)
  assert(root > 2.999 && root < 3.001, "math approximation")

  let duration, valid = std.time.Duration.from_milliseconds(5)
  assert(valid && duration.as_nanoseconds() == 5000000, "duration conversion")

  let mut arena = std.alloc.Arena.init()
  let mut output = std.strings.StringBuilder.init(arena.as_allocator())
  let writer = output.&mut.(*mut dyn std.io.Writer)
  assert(std.io.wprint(writer, "{u}{:u}{2:u}{u}", 0x41.(u32), 0xa2.(u32), 0x20ac.(u32), 0x1f600.(u32)).is_ok())
  assert(output.as_str().eq("A¢€😀"), "Unicode codepoint widths and indexed specifier")
  output.clear()
  assert(std.io.wprintln(writer, "{u}", 0x10ffff.(u32)).is_ok())
  let encoded = output.as_str()
  assert(len(encoded) == 5 && encoded[0] == 0xf4 && encoded[1] == 0x8f && encoded[2] == 0xbf && encoded[3] == 0xbf && encoded[4] == '\n', "maximum Unicode codepoint")
  output.clear()
  assert(std.io.wprint(writer, "{u}", 0.(u32)).is_ok())
  assert(len(output.as_str()) == 1 && output.as_str()[0] == 0, "null Unicode codepoint")
  output.clear()
  assert(std.io.wprint(writer, "{u}", 0xd800.(u32)).is_err(), "surrogate is invalid")
  assert(output.as_str().eq("<?>"), "surrogate format error")
  output.clear()
  assert(std.io.wprint(writer, "{u}", 0x110000.(u32)).is_err(), "out of range codepoint")
  output.clear()
  assert(std.io.wprint(writer, "{u}", 65.(u8)).is_err(), "Unicode specifier requires u32")
  arena.deinit()

  std.io.println("stdlib ok")
}
