module main

import std.io

let Base = comptime 6
let Product = comptime Base * 7
let Bits = comptime PointerBits

when ReleaseMode == .Release {
  let mode(): str = "release"
} else when ReleaseMode == .Debug {
  let mode(): str = "debug"
} else {
  @compiler_error("unknown release mode")
}

@comptime_assert(PointerBits == 32 || PointerBits == 64, "pointer width")

let main() {
  let local: i32 = comptime Product + 1
  when OS == .Linux || OS == .MacOS || OS == .Windows {
    assert(local == 43, "comptime arithmetic")
  } else {
    assert(local == 43, "portable comptime arithmetic")
  }
  std.io.println("{} {}", mode(), Bits)
}
