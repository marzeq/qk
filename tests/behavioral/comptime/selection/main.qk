module main

import std.io

let $Base = 6
let $Product = Base * 7
let $Bits: usz = PointerBits
let $Enabled = true

when ReleaseMode == .Release {
  let mode(): str = "release"
} else when ReleaseMode == .Debug {
  let mode(): str = "debug"
} else {
  @compiler_error("unknown release mode")
}

@compiler_assert(PointerBits == 32 || PointerBits == 64, "pointer width")

let main() {
  let $local: i32 = Product + 1
  assert(Enabled, "compile-time boolean")
  when OS == .Linux || OS == .MacOS || OS == .Windows {
    assert(local == 43, "compile-time arithmetic")
  } else {
    assert(local == 43, "portable compile-time arithmetic")
  }
  std.io.println("{} {}", mode(), Bits)
}
