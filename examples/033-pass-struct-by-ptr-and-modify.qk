let printf(s: *char, ...) = extern("printf")

let Point = type struct {
  x: i32
  y: i32
}

let setNewPos(var p: *Point, nx: i32, ny: i32) = {
  p.x = nx
  p.y = ny
}

let printPoint(p: Point) = {
  printf("Point(%d, %d)\n", p.x, p.y)
}

let main() = {
  let p = Point{ x=10, y=20 }
  printPoint(p)
  setNewPos(&p, 30, 40)
  printPoint(p)
}
