import("std")

let A = type struct {
  arr: [[u64]]
}

let f(a: [u64]) = {
  print_int(a[0])
}

let g(a: [u64, 2]) = {
  print_int(a[1])
}

let print_int(x: u64) = {
  std:printf("%u\n", x)
}

let main() = {
  let s = A {
    arr={ { 1, 2 }, { 3, 4 } }
  }

  print_int(s.arr[0][0])
  print_int([s.arr])
  f(s.arr[1])

  let arr = { 1, 2 } as [u64]
  g(arr)
}
