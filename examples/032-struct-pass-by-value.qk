declare printf(s: *char, ...): void
let printAFromQK(a: A) = {
  printf("QK: %d\n", a.a)
}

let main() = {
  var a = A{
    a = 3
    junk1 = 0
    junk2 = 0
    junk3 = 0
    junk4 = 0
    junk5 = 0
    junk6 = 0
    junk7 = 0
    junk8 = 0
  }
  printAFromQK(a) -- should print 3
  return a.a -- exit code should be 3
}
