module main

import (
  std.ctypes
  std.libc
  std.fs
  std.os
  std.io
  std.alloc
)

let termios = struct {
  c_iflag: std.ctypes.unsigned_int,
  c_oflag: std.ctypes.unsigned_int,
  c_cflag: std.ctypes.unsigned_int,
  c_lflag: std.ctypes.unsigned_int,
  c_cc: [32]std.ctypes.unsigned_char,
  c_line: std.ctypes.unsigned_char,
  c_ispeed: std.ctypes.unsigned_int,
  c_ospeed: std.ctypes.unsigned_int,
}

let tcgetattr(
  fd: std.ctypes.int,
  termios_p: *mut termios
): std.ctypes.int @foreign

let tcsetattr(
  fd: std.ctypes.int,
  optional_actions: std.ctypes.int,
  termios_p: *termios
): std.ctypes.int @foreign

let STDIN_FILENO: std.ctypes.int = $0

let TCSANOW: std.ctypes.unsigned_int = $0
let ICANON: std.ctypes.unsigned_int = $2
let ECHO: std.ctypes.unsigned_int = $8

let VTIME: std.ctypes.unsigned_int = $5
let VMIN: std.ctypes.unsigned_int = $6

let getchar(): std.ctypes.int {
  let mut old: termios = .{ --- }
  let mut new: termios = .{ --- }

  if tcgetattr(STDIN_FILENO, old.&mut) != 0 {
    return std.libc.getchar()
  }

  new = old

  new.c_lflag &= ~(ICANON | ECHO)
  new.c_cc[VTIME] = 0
  new.c_cc[VMIN] = 1

  if tcsetattr(STDIN_FILENO, TCSANOW.(std.ctypes.int), new.&) != 0 {
    return -1
  }

  let got = std.libc.getchar()

  tcsetattr(STDIN_FILENO, TCSANOW.(std.ctypes.int), old.&)

  return got
}

let main() {
  let mut arena = std.alloc.Arena.init()
  defer arena.deinit()
  let allocator = arena.as_allocator()

  let mut tape: [1024]i64 = [0; 1024]
  let mut ptr: usz = 0
  let mut pc: usz = 0

  if len(std.os.args) < 2 {
    std.io.eprintln("Usage: {} <filename>", std.os.args[0])
    std.os.exit(1)
  }

  let source = std.fs.read_file(allocator, std.os.args[1])
  if source.is_err() {
    std.io.eprintln("Failed to read '{}': ", std.os.args[1], source.unwrap_err())
    std.os.exit(1)
  }
  let source = source.unwrap().as_str()

  for pc < len(source) {
    let instruction = source[pc]

    match instruction {
      '>' => {
        ptr += 1

        if ptr >= len(tape) {
          std.io.eprintln("Error: tape pointer out of bounds")
          std.os.exit(1)
        }
      }

      '<' => {
        if ptr == 0 {
          std.io.eprintln("Error: tape pointer out of bounds")
          std.os.exit(1)
        }

        ptr -= 1
      }

      '+' => {
        tape[ptr] = (tape[ptr] + 1) & 255
      }

      '-' => {
        tape[ptr] = (tape[ptr] - 1) & 255
      }

      '.' => {
        std.libc.putchar(tape[ptr].(std.ctypes.int))
        std.libc.fflush(nil)
      }

      ',' => {
        let c = getchar()

        if c == -1 {
          tape[ptr] = 0
        } else {
          tape[ptr] = c.(i64)
        }
      }

      '[' => {
        if tape[ptr] == 0 {
          let mut depth: i64 = 1

          for depth > 0 {
            pc += 1

            if pc >= len(source) {
              std.io.eprintln("Error: unmatched '['")
              std.os.exit(1)
            }

            if source[pc] == '[' {
              depth += 1
            } else if source[pc] == ']' {
              depth -= 1
            }
          }
        }
      }

      ']' => {
        if tape[ptr] != 0 {
          let mut depth: i64 = 1

          for depth > 0 {
            if pc == 0 {
              std.io.eprintln("Error: unmatched ']'")
              std.os.exit(1)
            }

            pc -= 1

            if source[pc] == ']' {
              depth += 1
            } else if source[pc] == '[' {
              depth -= 1
            }
          }
        }
      }

      _ => {}
    }

    pc += 1
  }
}
