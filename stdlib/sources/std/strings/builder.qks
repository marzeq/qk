module std.strings

import std.alloc
import std.error

pub let StringBuilder = type struct {
  allocator: *mut dyn std.alloc.Allocator,
  ptr: *mut u8,
  count: usz,
  capacity: usz,
  read_offset: usz,
}

pub let SplitIterator = type struct {
  remaining: str,
  separator: str,
  finished: bool,
}

pub let split(value: str, separator: str): SplitIterator = .{
  remaining=value,
  separator=separator,
  finished=false,
}

pub let SplitIterator.next(*mut self): (str, bool) {
  if self.finished { return "", false }
  if @len(self.separator) == 0 {
    if @len(self.remaining) == 0 {
      self.finished = true
      return "", false
    }
    let result = self.remaining[0:1]
    self.remaining = self.remaining[1:]
    return result, true
  }

  let index, found = self.remaining.find(self.separator)
  if !found {
    self.finished = true
    return self.remaining, true
  }

  let result = self.remaining[0:index]
  self.remaining = self.remaining[index + @len(self.separator):]
  return result, true
}

let digit_value(value: u8): (u8, bool) {
  if value >= '0' && value <= '9' { return value - '0', true }
  if value >= 'a' && value <= 'z' { return value - 'a' + 10, true }
  if value >= 'A' && value <= 'Z' { return value - 'A' + 10, true }
  return 0, false
}

pub let parse_u64(value: str, base: u8 = 10): (u64, bool) {
  if @len(value) == 0 || base < 2 || base > 36 { return 0, false }

  let radix = base.(u64)
  let mut result: u64 = 0
  let mut index: usz = 0
  for index < @len(value) {
    let digit, valid = digit_value(value[index])
    if !valid || digit >= base { return 0, false }
    if result > ((~0.(u64)) - digit.(u64)) / radix { return 0, false }
    result = result * radix + digit.(u64)
    index += 1
  }
  return result, true
}

pub let parse_i64(value: str, base: u8 = 10): (i64, bool) {
  if @len(value) == 0 { return 0, false }
  let negative = value[0] == '-'
  let start: usz = if negative || value[0] == '+' { 1 } else { 0 }
  if start == @len(value) { return 0, false }

  let magnitude, valid = parse_u64(value[start:], base)
  if !valid { return 0, false }
  let positive_limit = 9223372036854775807.(u64)
  if negative {
    if magnitude > positive_limit + 1 { return 0, false }
    if magnitude == positive_limit + 1 { return (~9223372036854775807.(i64)), true }
    return -magnitude.(i64), true
  }
  if magnitude > positive_limit { return 0, false }
  return magnitude.(i64), true
}

pub let replace(
  allocator: *mut dyn std.alloc.Allocator,
  value: str,
  needle: str,
  replacement: str,
): (StringBuilder, bool) {
  let mut result = StringBuilder.init(allocator)
  if @len(needle) == 0 {
    return result, result.append(value.([]u8))
  }

  let mut remaining = value
  for true {
    let index, found = remaining.find(needle)
    if !found {
      if !result.append(remaining.([]u8)) {
        result.deinit()
        return StringBuilder.init(allocator), false
      }
      return result, true
    }

    if !result.append(remaining[0:index].([]u8)) || !result.append(replacement.([]u8)) {
      result.deinit()
      return StringBuilder.init(allocator), false
    }
    remaining = remaining[index + @len(needle):]
  }
  return result, true
}

pub let StringBuilder.init(
  allocator: *mut dyn std.alloc.Allocator,
): StringBuilder = .{
  allocator=allocator,
  ptr=nil,
  count=0,
  capacity=0,
  read_offset=0,
}

pub let StringBuilder.as_str(self): str {
  let bytes: []u8 = self.ptr[0:self.count]
  return bytes.(str)
}

pub let StringBuilder.ensure_capacity(
  *mut self,
  minimum_capacity: usz,
): bool {
  if minimum_capacity <= self.capacity {
    return true
  }

  let mut new_capacity: usz = if self.capacity == 0 { 8 } else { self.capacity }
  for new_capacity < minimum_capacity {
    if new_capacity > (~0.(usz)) / 2 {
      new_capacity = minimum_capacity
    } else {
      new_capacity *= 2
    }
  }

  let resized, success = std.alloc.resize<u8>(
    self.allocator,
    self.ptr[0:self.capacity],
    new_capacity,
  )
  if !success {
    return false
  }

  self.ptr = resized.(*mut u8)
  self.capacity = new_capacity
  return true
}

pub let StringBuilder.append(*mut self, bytes: []u8): bool {
  if @len(bytes) == 0 {
    return true
  }
  if @len(bytes) > (~0.(usz)) - self.count {
    return false
  }
  if !self.ensure_capacity(self.count + @len(bytes)) {
    return false
  }

  let mut index: usz = 0
  for index < @len(bytes) {
    self.ptr[self.count + index] = bytes[index]
    index += 1
  }
  self.count += @len(bytes)
  return true
}

pub let StringBuilder.write(
  *mut self,
  bytes: []u8,
): (usz, std.error.Error) {
  if !self.append(bytes) { return 0, std.error.Error.out_of_memory() }
  return @len(bytes), std.error.Error.none()
}

pub let StringBuilder.read(
  *mut self,
  buffer: []mut u8,
): (usz, std.error.Error) {
  let remaining = self.count - self.read_offset
  let count = if @len(buffer) < remaining { @len(buffer) } else { remaining }

  let mut index: usz = 0
  for index < count {
    buffer[index] = self.ptr[self.read_offset + index]
    index += 1
  }
  self.read_offset += count
  return count, std.error.Error.none()
}

pub let StringBuilder.reset_reader(*mut self): void {
  self.read_offset = 0
}

pub let StringBuilder.clear(*mut self): void {
  self.count = 0
  self.read_offset = 0
}

pub let StringBuilder.deinit(*mut self): void {
  std.alloc.free<u8>(self.allocator, self.ptr[0:self.capacity])
  self.ptr = nil
  self.count = 0
  self.capacity = 0
  self.read_offset = 0
}
