module std.io

pub let HasPrint = comptime true

let writer_or_default(writer: mut dyn Writer): mut dyn Writer {
  when HasIO {
    if writer == nil { return stdout.&mut.(mut dyn Writer) }
  }
  if writer == nil {
    panic("called std.io print without a writer in an environment without a default writer")
  }
  return writer
}

let format_print_argument(
  writer: mut dyn Writer,
  index: usz,
  arguments: []dyn Any,
): void {
  if index >= @len(arguments) {
    "<?>".format(writer)
    return
  }

  let argument = arguments[index]
  let formatted, ok = argument.(dyn Format)
  if ok {
    formatted.format(writer)
  } else {
    "<?>".format(writer)
  }
}

pub let print(
  format: str,
  arguments: []dyn Any = [],
  writer: mut dyn Writer = nil,
): void {
  let output = writer_or_default(writer)
  let mut format_index: usz = 0
  let mut argument_index: usz = 0

  for format_index < @len(format) {
    let character = format[format_index]
    if character == '}' and format_index + 1 < @len(format) and format[format_index + 1] == '}' {
      write_byte(output, '}')
      format_index += 2
      continue
    }
    if character != '{' {
      write_byte(output, character)
      format_index += 1
      continue
    }
    if format_index + 1 >= @len(format) {
      write_byte(output, '{')
      format_index += 1
      continue
    }
    if format[format_index + 1] == '{' {
      write_byte(output, '{')
      format_index += 2
      continue
    }
    if format[format_index + 1] == '}' {
      format_print_argument(output, argument_index, arguments)
      argument_index += 1
      format_index += 2
      continue
    }

    let mut cursor = format_index + 1
    let mut selected: usz = 0
    let mut has_digit = false
    for cursor < @len(format) and format[cursor].(usz) >= '0'.(usz) and format[cursor].(usz) <= '9'.(usz) {
      has_digit = true
      selected = selected * 10 + (format[cursor].(usz) - '0'.(usz))
      cursor += 1
    }
    if has_digit and cursor < @len(format) and format[cursor] == '}' {
      format_print_argument(output, selected, arguments)
      argument_index += 1
      format_index = cursor + 1
      continue
    }

    write_byte(output, '{')
    format_index += 1
  }
}

pub let println(
  format: str,
  arguments: []dyn Any = [],
  writer: mut dyn Writer = nil,
): void {
  let output = writer_or_default(writer)
  print(format, arguments, output)
  write_byte(output, '\n')
}
