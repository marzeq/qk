module std.io

let write_format_error(writer: *mut dyn Writer): void {
  "<?>".format(writer)
}

let format_print_argument(
  writer: *mut dyn Writer,
  index: usz,
  arguments: []*dyn Any,
): void {
  if index >= @len(arguments) {
    write_format_error(writer)
    return
  }

  let argument = arguments[index]
  let formatted, ok = argument.(*dyn Format)
  if ok {
    formatted.format(writer)
  } else {
    write_format_error(writer)
  }
}

let format_character_argument(
  writer: *mut dyn Writer,
  index: usz,
  arguments: []*dyn Any,
): void {
  if index >= @len(arguments) {
    write_format_error(writer)
    return
  }

  let character, ok = arguments[index].(u8)
  if ok {
    write_byte(writer, character)
  } else {
    write_format_error(writer)
  }
}

let format_hex_value(
  writer: *mut dyn Writer,
  value: u64,
  uppercase: bool,
): void {
  let digits = if uppercase { "0123456789ABCDEF" } else { "0123456789abcdef" }
  let mut buffer: [16]u8 = ---
  let mut cursor = @len(buffer)
  let mut remaining = value

  for true {
    cursor -= 1
    buffer[cursor] = digits[(remaining & 0xf).(usz)]
    remaining >>= 4
    if remaining == 0 { break }
  }

  write_all(writer, buffer[cursor:])
}

let format_hex_argument(
  writer: *mut dyn Writer,
  index: usz,
  arguments: []*dyn Any,
  uppercase: bool,
): void {
  if index >= @len(arguments) {
    write_format_error(writer)
    return
  }

  let argument = arguments[index]
  let value_u8, is_u8 = argument.(u8)
  if is_u8 {
    format_hex_value(writer, value_u8.(u64), uppercase)
    return
  }
  let value_u16, is_u16 = argument.(u16)
  if is_u16 {
    format_hex_value(writer, value_u16.(u64), uppercase)
    return
  }
  let value_u32, is_u32 = argument.(u32)
  if is_u32 {
    format_hex_value(writer, value_u32.(u64), uppercase)
    return
  }
  let value_u64, is_u64 = argument.(u64)
  if is_u64 {
    format_hex_value(writer, value_u64, uppercase)
    return
  }
  let value_usz, is_usz = argument.(usz)
  if is_usz {
    format_hex_value(writer, value_usz.(u64), uppercase)
    return
  }

  write_format_error(writer)
}

let format_general_float_argument(
  writer: *mut dyn Writer,
  index: usz,
  arguments: []*dyn Any,
): void {
  if index >= @len(arguments) {
    write_format_error(writer)
    return
  }
  let value_f32, is_f32 = arguments[index].(f32)
  if is_f32 {
    write_f64_general(writer, value_f32.(f64))
    return
  }
  let value_f64, is_f64 = arguments[index].(f64)
  if is_f64 {
    write_f64_general(writer, value_f64)
    return
  }
  write_format_error(writer)
}

let format_specified_argument(
  writer: *mut dyn Writer,
  index: usz,
  specifier: u8,
  arguments: []*dyn Any,
): void {
  if specifier == 'g' {
    format_general_float_argument(writer, index, arguments)
  } else if specifier == 'c' {
    format_character_argument(writer, index, arguments)
  } else if specifier == 'x' {
    format_hex_argument(writer, index, arguments, false)
  } else if specifier == 'X' {
    format_hex_argument(writer, index, arguments, true)
  } else {
    write_format_error(writer)
  }
}

pub let wprint(
  writer: *mut dyn Writer,
  format: str,
  arguments: ...*dyn Any
): void {
  let mut format_index: usz = 0
  let mut argument_index: usz = 0

  for format_index < @len(format) {
    let character = format[format_index]
    if character == '}' && format_index + 1 < @len(format) && format[format_index + 1] == '}' {
      write_byte(writer, '}')
      format_index += 2
      continue
    }
    if character != '{' {
      write_byte(writer, character)
      format_index += 1
      continue
    }
    if format_index + 1 >= @len(format) {
      write_byte(writer, '{')
      format_index += 1
      continue
    }
    if format[format_index + 1] == '{' {
      write_byte(writer, '{')
      format_index += 2
      continue
    }
    if format[format_index + 1] == '}' {
      format_print_argument(writer, argument_index, arguments)
      argument_index += 1
      format_index += 2
      continue
    }
    if format_index + 2 < @len(format) && format[format_index + 2] == '}' {
      let specifier = format[format_index + 1]
      if specifier == 'g' || specifier == 'c' || specifier == 'x' || specifier == 'X' {
        format_specified_argument(writer, argument_index, specifier, arguments)
        argument_index += 1
        format_index += 3
        continue
      }
    }
    if format_index + 3 < @len(format) && format[format_index + 1] == ':' && format[format_index + 3] == '}' {
      let specifier = format[format_index + 2]
      if specifier == 'g' || specifier == 'c' || specifier == 'x' || specifier == 'X' {
        format_specified_argument(writer, argument_index, specifier, arguments)
        argument_index += 1
        format_index += 4
        continue
      }
    }

    let mut cursor = format_index + 1
    let mut selected: usz = 0
    let mut has_digit = false
    for cursor < @len(format) && format[cursor].(usz) >= '0'.(usz) && format[cursor].(usz) <= '9'.(usz) {
      has_digit = true
      selected = selected * 10 + (format[cursor].(usz) - '0'.(usz))
      cursor += 1
    }
    if has_digit && cursor < @len(format) {
      if format[cursor] == '}' {
        format_print_argument(writer, selected, arguments)
        argument_index = selected + 1
        format_index = cursor + 1
        continue
      }
      if cursor + 2 < @len(format) && format[cursor] == ':' && format[cursor + 2] == '}' {
        let specifier = format[cursor + 1]
        if specifier == 'g' || specifier == 'c' || specifier == 'x' || specifier == 'X' {
          format_specified_argument(writer, selected, specifier, arguments)
          argument_index = selected + 1
          format_index = cursor + 3
          continue
        }
      }
    }

    write_byte(writer, '{')
    format_index += 1
  }
}

pub let wprintln(
  writer: *mut dyn Writer,
  format: str,
  arguments: ...*dyn Any
): void {
  wprint(writer, format, arguments...)
  write_byte(writer, '\n')
}

when HasIO {

pub let print(
  format: str,
  arguments: ...*dyn Any
): void {
  wprint(stdout.&mut.(*mut dyn Writer), format, arguments...)
}

pub let println(
  format: str,
  arguments: ...*dyn Any
): void {
  wprintln(stdout.&mut.(*mut dyn Writer), format, arguments...)
}

}

when HasFiles {

pub let fprint(
  format: str,
  file: *mut FileWriter,
  arguments: ...*dyn Any
): void {
  wprint(file.(*mut dyn Writer), format, arguments...)
}

pub let fprintln(
  format: str,
  file: *mut FileWriter,
  arguments: ...*dyn Any
): void {
  wprintln(file.(*mut dyn Writer), format, arguments...)
}

}

when HasIO {

pub let eprint(
  format: str,
  arguments: ...*dyn Any
): void {
  wprint(stderr.&mut.(*mut dyn Writer), format, arguments...)
}

pub let eprintln(
  format: str,
  arguments: ...*dyn Any
): void {
  wprintln(stderr.&mut.(*mut dyn Writer), format, arguments...)
}

}
