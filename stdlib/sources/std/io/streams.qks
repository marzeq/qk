module std.io

pub let HasIO = comptime not NoLibc

pub let Writer = type trait {
  let write(*mut self, bytes: []u8): usz
}

pub let Reader = type trait {
  let read(*mut self, buffer: []mut u8): usz
}

when HasIO {
import std
import std.alloc
import std.libc

pub let FileWriter = type struct {
  file: *std.libc.FILE,
}

pub let FileReader = type struct {
  file: *std.libc.FILE,
}

pub let FileWriter.open(
  path: str,
  append: bool = false,
): FileWriter {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .{ file=nil } }

  let file = std.libc.fopen(c_path, if append { c"ab" } else { c"wb" })
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return .{ file=file }
}

pub let FileWriter.from_file(file: *std.libc.FILE): FileWriter = .{ file=file }

pub let FileWriter.is_open(*self): bool = self.file != nil

pub let FileWriter.write(*mut self, bytes: []u8): usz {
  if self.file == nil or @len(bytes) == 0 { return 0 }
  return std.libc.fwrite(bytes.(*u8), 1, @len(bytes), self.file)
}

pub let FileWriter.flush(*mut self): bool =
  self.file != nil and std.libc.fflush(self.file) == 0

pub let FileWriter.close(*mut self): bool {
  if self.file == nil { return true }
  let file = self.file
  self.file = nil
  return std.libc.fclose(file) == 0
}

pub let FileReader.open(
  path: str,
): FileReader {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.(mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .{ file=nil } }

  let file = std.libc.fopen(c_path, c"rb")
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return .{ file=file }
}

pub let FileReader.from_file(file: *std.libc.FILE): FileReader = .{ file=file }

pub let FileReader.is_open(*self): bool = self.file != nil

pub let FileReader.read(*mut self, buffer: []mut u8): usz {
  if self.file == nil or @len(buffer) == 0 { return 0 }
  return std.libc.fread(buffer.(*mut u8), 1, @len(buffer), self.file)
}

pub let FileReader.format(self, writer: mut dyn Writer): void {
  let mut reader = self
  let mut buffer: [4096]u8 = ---

  for true {
    let count = reader.read(buffer[:])
    if count == 0 { break }
    if write_all(writer, buffer[0:count]) != count { break }
  }
}

pub let FileReader.close(*mut self): bool {
  if self.file == nil { return true }
  let file = self.file
  self.file = nil
  return std.libc.fclose(file) == 0
}

pub let mut stdout: FileWriter = .{ file=std.libc.stdout }
pub let mut stderr: FileWriter = .{ file=std.libc.stderr }
pub let mut stdin: FileReader = .{ file=std.libc.stdin }
}

pub let write_all(writer: mut dyn Writer, bytes: []u8): usz {
  let mut written: usz = 0
  for written < @len(bytes) {
    let count = writer.write(bytes[written:])
    if count == 0 { break }
    written += count
  }
  return written
}
