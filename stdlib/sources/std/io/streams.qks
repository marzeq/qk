module std.io

import std.strings

pub let HasIO = comptime !NoLibc

pub let Writer = type trait {
  let write(*mut self, bytes: []u8): usz

  let write_builder(
    *mut self,
    builder: *std.strings.StringBuilder,
  ): usz = self.write(builder.as_str().([]u8))
}

pub let Reader = type trait {
  let read(*mut self, buffer: []mut u8): usz

  let read_to_builder(
    *mut self,
    builder: *mut std.strings.StringBuilder,
  ): usz {
    let mut total: usz = 0
    let mut buffer: [4096]u8 = ---
    for true {
      let count = self.read(buffer[:])
      if count == 0 { break }
      let written = builder.write(buffer[0:count])
      total += written
      if written != count { break }
    }
    return total
  }
}

when HasIO {
import std
import std.alloc
import std.libc
import std.os

pub let ReadStatus = type enum {
  Data,
  End,
  Error,
}

pub let FileWriter = type struct {
  handle: *void,
}

pub let FileReader = type struct {
  handle: *void,
}

pub let FileWriter.open(
  path: str,
  append: bool = false,
): FileWriter {
  let file, _ = FileWriter.open_checked(path, append)
  return file
}

pub let FileWriter.open_checked(
  path: str,
  append: bool = false,
): (FileWriter, std.os.Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .{ handle=nil }, std.os.Error.out_of_memory() }

  let file = std.libc.fopen(c_path, if append { c"ab" } else { c"wb" })
  let error = if file == nil { std.os.last_error() } else { std.os.Error.none() }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return .{ handle=file.(*void) }, error
}

pub let FileWriter.is_open(*self): bool = self.handle != nil

pub let FileWriter.write(*mut self, bytes: []u8): usz {
  let count, _ = self.write_some_checked(bytes)
  return count
}

pub let FileWriter.write_some_checked(
  *mut self,
  bytes: []u8,
): (usz, std.os.Error) {
  if self.handle == nil { return 0, std.os.Error.invalid_handle() }
  if @len(bytes) == 0 { return 0, std.os.Error.none() }

  let file = self.handle.(*std.libc.FILE)
  let count = std.libc.write(std.libc.fileno(file), bytes.(*u8), @len(bytes))
  if count < 0 { return 0, std.os.last_error() }
  return count.(usz), std.os.Error.none()
}

pub let FileWriter.write_all(*mut self, bytes: []u8): bool {
  let written, error = self.write_all_checked(bytes)
  return written == @len(bytes) && error.is_none()
}

pub let FileWriter.write_all_checked(
  *mut self,
  bytes: []u8,
): (usz, std.os.Error) {
  let mut written: usz = 0
  for written < @len(bytes) {
    let count, error = self.write_some_checked(bytes[written:])
    if error.is_error() { return written, error }
    if count == 0 { return written, std.os.Error.no_progress() }
    written += count
  }
  return written, std.os.Error.none()
}

pub let FileWriter.flush(*mut self): bool = self.flush_checked().is_none()

pub let FileWriter.flush_checked(*mut self): std.os.Error {
  if self.handle == nil { return std.os.Error.invalid_handle() }
  if std.libc.fflush(self.handle.(*std.libc.FILE)) != 0 {
    return std.os.last_error()
  }
  return std.os.Error.none()
}

pub let FileWriter.close(*mut self): bool {
  return self.close_checked().is_none()
}

pub let FileWriter.close_checked(*mut self): std.os.Error {
  if self.handle == nil { return std.os.Error.none() }
  let file = self.handle.(*std.libc.FILE)
  self.handle = nil
  if std.libc.fclose(file) != 0 { return std.os.last_error() }
  return std.os.Error.none()
}

pub let FileReader.open(
  path: str,
): FileReader {
  let file, _ = FileReader.open_checked(path)
  return file
}

pub let FileReader.open_checked(
  path: str,
): (FileReader, std.os.Error) {
  let mut lc = std.alloc.LibcAllocator.init()
  let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
  let c_path = path.to_cstr(allocator)
  if c_path == nil { return .{ handle=nil }, std.os.Error.out_of_memory() }

  let file = std.libc.fopen(c_path, c"rb")
  let error = if file == nil { std.os.last_error() } else { std.os.Error.none() }
  allocator.free_bytes(c_path, @len(path) + 1, @alignof(u8))
  return .{ handle=file.(*void) }, error
}

pub let FileReader.is_open(*self): bool = self.handle != nil

pub let FileReader.read(*mut self, buffer: []mut u8): usz {
  let count, _ = self.read_some(buffer)
  return count
}

pub let FileReader.read_some(
  *mut self,
  buffer: []mut u8,
): (usz, ReadStatus) {
  let count, status, _ = self.read_some_checked(buffer)
  return count, status
}

pub let FileReader.read_some_checked(
  *mut self,
  buffer: []mut u8,
): (usz, ReadStatus, std.os.Error) {
  if self.handle == nil { return 0, .Error, std.os.Error.invalid_handle() }
  if @len(buffer) == 0 { return 0, .Data, std.os.Error.none() }

  let count = std.libc.read(
    std.libc.fileno(self.handle.(*std.libc.FILE)),
    buffer.(*mut u8),
    @len(buffer),
  )
  if count < 0 { return 0, .Error, std.os.last_error() }
  if count == 0 { return 0, .End, std.os.Error.none() }
  return count.(usz), .Data, std.os.Error.none()
}

pub let FileReader.format(self, writer: *mut dyn Writer): void {
  let mut reader = self
  let mut buffer: [4096]u8 = ---

  for true {
    let count, status = reader.read_some(buffer[:])
    if status != .Data { break }
    if write_all(writer, buffer[0:count]) != count { break }
  }
}

pub let FileReader.close(*mut self): bool {
  return self.close_checked().is_none()
}

pub let FileReader.close_checked(*mut self): std.os.Error {
  if self.handle == nil { return std.os.Error.none() }
  let file = self.handle.(*std.libc.FILE)
  self.handle = nil
  if std.libc.fclose(file) != 0 { return std.os.last_error() }
  return std.os.Error.none()
}

pub let FileReader.read_line_checked(
  *mut self,
  buffer: []mut u8,
): (usz, ReadStatus, std.os.Error) {
  if self.handle == nil { return 0, .Error, std.os.Error.invalid_handle() }
  if @len(buffer) == 0 { return 0, .Data, std.os.Error.none() }

  let file = self.handle.(*std.libc.FILE)
  let c_buffer = buffer.(*mut u8)
  let line = std.libc.fgets(c_buffer, @len(buffer).(i32), file)
  if line == nil {
    if std.libc.feof(file) != 0 { return 0, .End, std.os.Error.none() }
    return 0, .Error, std.os.last_error()
  }

  let count = std.libc.strnlen(c_buffer, @len(buffer)).(usz)
  return count, .Data, std.os.Error.none()
}

pub let FileReader.read_line(*mut self, buffer: []mut u8): (usz, ReadStatus) {
  let count, status, _ = self.read_line_checked(buffer)
  return count, status
}

pub let mut stdout: FileWriter = .{ handle=std.libc.stdout.(*void) }
pub let mut stderr: FileWriter = .{ handle=std.libc.stderr.(*void) }
pub let mut stdin: FileReader = .{ handle=std.libc.stdin.(*void) }
}

pub let write_all(writer: *mut dyn Writer, bytes: []u8): usz {
  let mut written: usz = 0
  for written < @len(bytes) {
    let count = writer.write(bytes[written:])
    if count == 0 { break }
    written += count
  }
  return written
}
