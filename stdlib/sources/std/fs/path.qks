module std.fs

import std
import std.alloc
import std.collections
import std.strings

pub let Path = type struct {
  bytes: std.collections.DynamicArray<u8>,
}

pub let Path.init(allocator: *mut dyn std.alloc.Allocator): Path = .{
  bytes=std.collections.DynamicArray<u8>.init(allocator),
}

pub let Path.from_str(
  allocator: *mut dyn std.alloc.Allocator,
  value: str,
): (Path, bool) {
  let mut result = Path.init(allocator)
  if !result.bytes.ensure_capacity(@len(value)) {
    return result, false
  }
  
  for let mut index: usz = 0; index < @len(value); index += 1 {
    result.bytes.ptr[index] = value[index]
  }

  result.bytes.count = @len(value)
  return result, true
}

pub let Path.from_cstr(
  allocator: *mut dyn std.alloc.Allocator,
  value: cstr,
): (Path, bool) {
  if value == nil { return Path.init(allocator), false }
  return Path.from_str(allocator, value.to_str())
}

pub let Path.from_string_builder(
  value: *std.strings.StringBuilder,
): (Path, bool) {
  return Path.from_str(value.allocator, value.as_str())
}

pub let Path.from_builder(
  value: *std.strings.StringBuilder,
): (Path, bool) = Path.from_string_builder(value)

pub let Path.to_str(self): str = self.bytes.as_slice().(str)

pub let Path.to_string_builder(self): (std.strings.StringBuilder, bool) {
  let mut result = std.strings.StringBuilder.init(self.bytes.allocator)
  let value = self.to_str()
  if result.write(value.([]u8)) != @len(value) {
    result.deinit()
    return std.strings.StringBuilder.init(self.bytes.allocator), false
  }
  return result, true
}

pub let Path.to_str_builder(self): (std.strings.StringBuilder, bool) =
  self.to_string_builder()

pub let Path.deinit(*mut self): void {
  self.bytes.deinit()
}

when OS == .Windows {
  pub let Separator: u8 = '\\'
} else {
  pub let Separator: u8 = '/'
}

let is_separator(value: u8): bool {
  if value == '/' { return true }
  when OS == .Windows { return value == '\\' }
  else { return false }
}

pub let is_absolute(path: str): bool {
  if @len(path) == 0 { return false }
  when OS == .Windows {
    if is_separator(path[0]) { return true }
    return @len(path) >= 3 && path[1] == ':' && is_separator(path[2])
  } else {
    return path[0] == '/'
  }
}

pub let Path.is_absolute(self): bool = is_absolute(self.to_str())

pub let basename(path: str): str {
  let mut end = @len(path)
  for end > 1 && is_separator(path[end - 1]) { end -= 1 }
  let mut start = end
  for start > 0 && !is_separator(path[start - 1]) { start -= 1 }
  return path[start:end]
}

pub let Path.basename(self): str = basename(self.to_str())

pub let dirname(path: str): str {
  let mut end = @len(path)
  for end > 1 && is_separator(path[end - 1]) { end -= 1 }
  for end > 0 && !is_separator(path[end - 1]) { end -= 1 }
  for end > 1 && is_separator(path[end - 1]) { end -= 1 }
  if end == 0 { return "." }
  return path[0:end]
}

pub let Path.dirname(self): str = dirname(self.to_str())

pub let extension(path: str): str {
  let name = basename(path)
  let mut index = @len(name)
  for index > 0 {
    index -= 1
    if name[index] == '.' {
      if index == 0 { return "" }
      return name[index:]
    }
  }
  return ""
}

pub let Path.extension(self): str = extension(self.to_str())

pub let join(
  allocator: *mut dyn std.alloc.Allocator,
  left: str,
  right: str,
): (std.strings.StringBuilder, bool) {
  let mut result = std.strings.StringBuilder.init(allocator)
  if is_absolute(right) {
    return result, result.write(right.([]u8)) == @len(right)
  }
  if result.write(left.([]u8)) != @len(left) {
    result.deinit()
    return std.strings.StringBuilder.init(allocator), false
  }
  if @len(left) > 0 && !is_separator(left[@len(left) - 1]) {
    let separator: [1]u8 = [Separator]
    if result.write(separator[:]) != 1 {
      result.deinit()
      return std.strings.StringBuilder.init(allocator), false
    }
  }
  if result.write(right.([]u8)) != @len(right) {
    result.deinit()
    return std.strings.StringBuilder.init(allocator), false
  }
  return result, true
}

let Path.join_one(self, right: str): (Path, bool) {
  if is_absolute(right) {
    return Path.from_str(self.bytes.allocator, right)
  }

  let mut result, success = Path.from_str(self.bytes.allocator, self.to_str())
  if !success { return result, false }
  let left = self.to_str()
  if @len(left) > 0 && !is_separator(left[@len(left) - 1]) {
    if !result.bytes.append(Separator) {
      result.deinit()
      return Path.init(self.bytes.allocator), false
    }
  }
  let mut index: usz = 0
  for index < @len(right) {
    if !result.bytes.append(right[index]) {
      result.deinit()
      return Path.init(self.bytes.allocator), false
    }
    index += 1
  }
  return result, true
}

let Path.join_path_one(self, right: *Path): (Path, bool) =
  self.join(right.to_str())

pub let Path.join(self, right: ...str): (Path, bool) {
  let mut s = self
  for r in right {
    let mut result, success = s.join_one(r)
    if !success { return result, false }
    s = result
  }
  return s, true
}

pub let Path.join_path(self, right: ...*Path): (Path, bool) {
  let mut s = self
  for r in right {
    let mut result, success = s.join_path_one(r)
    if !success { return result, false }
    s = result
  }
  return s, true
}
