module std.libc

when TargetHasLibc {
  @link(system "c")

import std.ctypes

pub let FILE = type opaque
pub let DIR = type opaque

// -----------------------------------------------------------------------------
// C ABI types
// -----------------------------------------------------------------------------

pub let time_t = type
  when OS == .Windows
    || OS == .MacOS
    || OS == .FreeBSD
    || OS == .OpenBSD
    || OS == .NetBSD
    || OS == .DragonFly
    || OS == .WASI { std.ctypes.long_long }
    else when OS == .Linux { std.ctypes.long }
    else {
    @compiler_error("Unsupported time_t ABI")
  }

pub let clock_t = type
  when OS == .Windows
    || OS == .FreeBSD
    || OS == .OpenBSD
    || OS == .NetBSD
    || OS == .DragonFly { std.ctypes.int }
    else { std.ctypes.long }

// -----------------------------------------------------------------------------
// stdio
// -----------------------------------------------------------------------------

pub let printf(fmt: cstr, ...): std.ctypes.int @foreign
pub let fprintf(stream: *FILE, fmt: cstr, ...): std.ctypes.int @foreign
pub let sprintf(buffer: *mut std.ctypes.char, fmt: cstr, ...): std.ctypes.int @foreign
pub let snprintf(buffer: *mut std.ctypes.char, n: std.ctypes.size_t, fmt: cstr, ...): std.ctypes.int @foreign

pub let scanf(fmt: cstr, ...): std.ctypes.int @foreign
pub let fscanf(stream: *FILE, fmt: cstr, ...): std.ctypes.int @foreign
pub let sscanf(str: cstr, fmt: cstr, ...): std.ctypes.int @foreign

pub let putchar(ch: std.ctypes.int): std.ctypes.int @foreign
pub let getchar(): std.ctypes.int @foreign
pub let puts(str: cstr): std.ctypes.int @foreign

pub let fopen(path: cstr, mode: cstr): *FILE @foreign
when OS != .Windows {
  pub let fdopen(fd: std.ctypes.int, mode: cstr): *FILE @foreign
}
pub let fclose(file: *FILE): std.ctypes.int @foreign

pub let fread(
  ptr: *mut void,
  size: std.ctypes.size_t,
  count: std.ctypes.size_t,
  stream: *FILE,
): std.ctypes.size_t @foreign

pub let fwrite(
  ptr: *void,
  size: std.ctypes.size_t,
  count: std.ctypes.size_t,
  stream: *FILE,
): std.ctypes.size_t @foreign

pub let SeekOrigin = type enum {
  Set = 0,
  Cur = 1,
  End = 2,
}

pub let fseek(stream: *FILE, offset: std.ctypes.long, whence: SeekOrigin): std.ctypes.int @foreign

pub let ftell(stream: *FILE): std.ctypes.long @foreign

pub let rewind(stream: *FILE): void @foreign
pub let fflush(stream: *FILE): std.ctypes.int @foreign
pub let feof(stream: *FILE): std.ctypes.int @foreign
pub let ferror(stream: *FILE): std.ctypes.int @foreign
pub let clearerr(stream: *FILE): void @foreign

pub let fgets(s: *mut std.ctypes.char, n: std.ctypes.int, stream: *FILE): *mut std.ctypes.char @foreign
pub let fgetc(stream: *FILE): std.ctypes.int @foreign
pub let fputs(s: cstr, stream: *FILE): std.ctypes.int @foreign
pub let fputc(ch: std.ctypes.int, stream: *FILE): std.ctypes.int @foreign

pub let remove(path: cstr): std.ctypes.int @foreign
pub let rename(old: cstr, new: cstr): std.ctypes.int @foreign
pub let tmpfile(): *FILE @foreign

when OS == .Windows {
  pub let mkdir(path: cstr): std.ctypes.int @foreign(symbol "_mkdir")
  pub let rmdir(path: cstr): std.ctypes.int @foreign(symbol "_rmdir")
  pub let chdir(path: cstr): std.ctypes.int @foreign(symbol "_chdir")
  pub let getcwd(buffer: *mut std.ctypes.char, size: std.ctypes.int): *mut std.ctypes.char @foreign(symbol "_getcwd")

  pub let InvalidFileAttributes: std.ctypes.unsigned_long = 0xffffffff
  pub let FileAttributeDirectory: std.ctypes.unsigned_long = 0x10
  pub let get_file_attributes(path: cstr): std.ctypes.unsigned_long @foreign(symbol "GetFileAttributesA")
} else {
  pub let mkdir(path: cstr, mode: std.ctypes.unsigned_int): std.ctypes.int @foreign
  pub let rmdir(path: cstr): std.ctypes.int @foreign
  pub let opendir(path: cstr): *DIR @foreign
  pub let closedir(directory: *DIR): std.ctypes.int @foreign
}

pub let EOF: std.ctypes.int = comptime -1

when OS == .Windows {
  pub let fileno(stream: *FILE): std.ctypes.int @foreign(symbol "_fileno")
} else {
  pub let fileno(stream: *FILE): std.ctypes.int @foreign
}

when OS == .Windows {
  let windows_read(
    fd: std.ctypes.int,
    buf: *mut void,
    count: std.ctypes.unsigned_int,
  ): std.ctypes.int @foreign(symbol "_read")

  let windows_write(
    fd: std.ctypes.int,
    buf: *void,
    count: std.ctypes.unsigned_int,
  ): std.ctypes.int @foreign(symbol "_write")

  pub let read(
    fd: std.ctypes.int,
    buf: *mut void,
    count: std.ctypes.size_t,
  ): std.ctypes.ssize_t {
    let limited = if count > 0xffffffff.(std.ctypes.size_t) { 0xffffffff.(std.ctypes.size_t) } else { count }
    return windows_read(fd, buf, limited.(std.ctypes.unsigned_int)).(std.ctypes.ssize_t)
  }

  pub let write(
    fd: std.ctypes.int,
    buf: *void,
    count: std.ctypes.size_t,
  ): std.ctypes.ssize_t {
    let limited = if count > 0xffffffff.(std.ctypes.size_t) { 0xffffffff.(std.ctypes.size_t) } else { count }
    return windows_write(fd, buf, limited.(std.ctypes.unsigned_int)).(std.ctypes.ssize_t)
  }
} else {
  pub let read(
    fd: std.ctypes.int,
    buf: *mut void,
    count: std.ctypes.size_t,
  ): std.ctypes.ssize_t @foreign

  pub let write(
    fd: std.ctypes.int,
    buf: *void,
    count: std.ctypes.size_t,
  ): std.ctypes.ssize_t @foreign
}

when OS == .Windows {
  pub let errno_location(): *mut std.ctypes.int @foreign(symbol "_errno")
} else when OS == .Linux || OS == .WASI {
  pub let errno_location(): *mut std.ctypes.int @foreign(symbol "__errno_location")
} else when OS == .MacOS
  || OS == .FreeBSD
  || OS == .OpenBSD
  || OS == .NetBSD
  || OS == .DragonFly {
  pub let errno_location(): *mut std.ctypes.int @foreign(symbol "__error")
} else {
  @compiler_error("Unsupported errno ABI")
}

pub let strerror(error: std.ctypes.int): cstr @foreign

// -----------------------------------------------------------------------------
// memory
// -----------------------------------------------------------------------------

pub let malloc(size: std.ctypes.size_t): *mut void @foreign
pub let calloc(count: std.ctypes.size_t, size: std.ctypes.size_t): *mut void @foreign
pub let realloc(ptr: *void, size: std.ctypes.size_t): *mut void @foreign
pub let free(ptr: *void): void @foreign

pub let memcpy(dest: *mut void, src: *void, n: std.ctypes.size_t): *mut void @foreign
pub let memmove(dest: *mut void, src: *void, n: std.ctypes.size_t): *mut void @foreign
pub let memset(dest: *mut void, value: std.ctypes.int, n: std.ctypes.size_t): *mut void @foreign
pub let memcmp(s1: *void, s2: *void, n: std.ctypes.size_t): std.ctypes.int @foreign
pub let memchr(ptr: *void, value: std.ctypes.int, n: std.ctypes.size_t): *void @foreign

// -----------------------------------------------------------------------------
// strings
// -----------------------------------------------------------------------------

pub let strlen(s: cstr): std.ctypes.size_t @foreign
pub let strnlen(s: cstr, maxlen: std.ctypes.size_t): std.ctypes.size_t @foreign
pub let strcmp(a: cstr, b: cstr): std.ctypes.int @foreign
pub let strncmp(a: cstr, b: cstr, n: std.ctypes.size_t): std.ctypes.int @foreign

pub let strcpy(dest: *mut std.ctypes.char, src: cstr): *mut std.ctypes.char @foreign

pub let strncpy(dest: *mut std.ctypes.char, src: cstr, n: std.ctypes.size_t): *mut std.ctypes.char @foreign

pub let strcat(dest: *mut std.ctypes.char, src: cstr): *mut std.ctypes.char @foreign

pub let strncat(
  dest: *mut std.ctypes.char,
  src: cstr,
  n: std.ctypes.size_t,
): *mut std.ctypes.char @foreign

pub let strchr(s: cstr, ch: std.ctypes.int): *std.ctypes.char @foreign
pub let strrchr(s: cstr, ch: std.ctypes.int): *std.ctypes.char @foreign
pub let strstr(haystack: cstr, needle: cstr): *std.ctypes.char @foreign

pub let strtok(str: *mut std.ctypes.char, delim: cstr): *mut std.ctypes.char @foreign

when OS == .Windows {
  pub let strdup(str: cstr): *mut std.ctypes.char @foreign(symbol "_strdup")
  pub let strcasecmp(a: cstr, b: cstr): std.ctypes.int @foreign(symbol "_stricmp")
} else {
  pub let strdup(str: cstr): *mut std.ctypes.char @foreign
  pub let strcasecmp(a: cstr, b: cstr): std.ctypes.int @foreign
}

// -----------------------------------------------------------------------------
// conversion
// -----------------------------------------------------------------------------

pub let atoi(str: cstr): std.ctypes.int @foreign
pub let atol(str: cstr): std.ctypes.long @foreign
pub let atof(str: cstr): std.ctypes.double @foreign

pub let strtol(str: cstr, end: *mut *mut std.ctypes.char, base: std.ctypes.int): std.ctypes.long @foreign

pub let strtoul(str: cstr, end: *mut *mut std.ctypes.char, base: std.ctypes.int): std.ctypes.unsigned_long @foreign

// -----------------------------------------------------------------------------
// random / time
// -----------------------------------------------------------------------------

when OS == .Windows {
  pub let time(t: *mut time_t): time_t @foreign(symbol "_time64")
} else {
  pub let time(t: *mut time_t): time_t @foreign
}

pub let clock(): clock_t @foreign

pub let srand(seed: std.ctypes.unsigned_int): void @foreign
pub let rand(): std.ctypes.int @foreign

// -----------------------------------------------------------------------------
// process
// -----------------------------------------------------------------------------

pub let exit(code: std.ctypes.int): void @foreign @noreturn
pub let abort(): void @foreign @noreturn

pub let system(command: cstr): std.ctypes.int @foreign
pub let getenv(name: cstr): *std.ctypes.char @foreign

// -----------------------------------------------------------------------------
// standard streams
// -----------------------------------------------------------------------------

when OS == .Linux || OS == .WASI {

  pub let stdin: *FILE @foreign
  pub let stdout: *FILE @foreign
  pub let stderr: *FILE @foreign

} else when OS == .MacOS
  || OS == .FreeBSD
  || OS == .OpenBSD
  || OS == .NetBSD
  || OS == .DragonFly {

  // On the BSD libc ABIs these names are macros backed by non-portable
  // symbols (for example __stdinp on macOS and FreeBSD, and __sF on
  // NetBSD). Obtain the POSIX streams from their standard descriptors
  // instead of referring to nonexistent stdin/stdout/stderr symbols. Keep
  // these lazy so merely importing the bindings does not open three streams.
  pub let stdin(): *FILE = fdopen(0, c"r")
  pub let stdout(): *FILE = fdopen(1, c"w")
  pub let stderr(): *FILE = fdopen(2, c"w")

} else when OS == .Windows {

  let _acrt_iob_func(index: std.ctypes.unsigned_int): *FILE @foreign(symbol "__acrt_iob_func")

  pub let stdin(): *FILE = _acrt_iob_func(0)
  pub let stdout(): *FILE = _acrt_iob_func(1)
  pub let stderr(): *FILE = _acrt_iob_func(2)

} else {
  @compiler_error("Unsupported OS")
}

// -----------------------------------------------------------------------------
// Unix process management
// -----------------------------------------------------------------------------

when OS == .Linux
  || OS == .MacOS
  || OS == .FreeBSD
  || OS == .OpenBSD
  || OS == .NetBSD
  || OS == .DragonFly {

  // On the supported Unix ABIs, pid_t is a signed 32-bit integer.
  pub let pid_t = type std.ctypes.int

  // POSIX uses int for file descriptors, signals and wait status values.
  pub let fd_t = type std.ctypes.int
  pub let signal_t = type std.ctypes.int
  pub let wait_status_t = type std.ctypes.int

  // Environment inherited by exec-family calls.
  pub let environ: *mut *mut std.ctypes.char @foreign

  // ---------------------------------------------------------------------------
  // Process creation and termination
  // ---------------------------------------------------------------------------

  pub let fork(): pid_t @foreign

  // vfork() imposes substantially stricter rules than fork(). The child must
  // call exec*() or _exit() without returning or modifying shared state.
  pub let vfork(): pid_t @foreign

  pub let _exit(status: std.ctypes.int): void @foreign @noreturn

  // ---------------------------------------------------------------------------
  // Program execution
  // ---------------------------------------------------------------------------

  // The vector forms are generally the easiest and safest FFI bindings.
  //
  // argv must be terminated by a null pointer.
  // envp must be terminated by a null pointer.
  pub let execve(
    path: cstr,
    argv: **std.ctypes.char,
    envp: **std.ctypes.char,
  ): std.ctypes.int @foreign

  pub let execv(
    path: cstr,
    argv: **std.ctypes.char,
  ): std.ctypes.int @foreign

  pub let execvp(
    file: cstr,
    argv: **std.ctypes.char,
  ): std.ctypes.int @foreign

  // Variadic exec forms. The argument list must end with a null pointer.
  pub let execl(path: cstr, arg0: cstr, ...): std.ctypes.int @foreign
  pub let execlp(file: cstr, arg0: cstr, ...): std.ctypes.int @foreign

  // execle() also requires envp after the null argument-list terminator.
  pub let execle(path: cstr, arg0: cstr, ...): std.ctypes.int @foreign

  // exec*() returns only when execution fails, in which case it returns -1.

  // ---------------------------------------------------------------------------
  // Waiting for child processes
  // ---------------------------------------------------------------------------

  pub let wait(status: *mut wait_status_t): pid_t @foreign

  pub let waitpid(
    pid: pid_t,
    status: *mut wait_status_t,
    options: std.ctypes.int,
  ): pid_t @foreign

  // waitpid() pid argument meanings.
  pub let WaitAny: pid_t = -1
  pub let WaitMyProcessGroup: pid_t = 0

  // POSIX waitpid() option bits.
  pub let WaitNoHang: std.ctypes.int = 1
  pub let WaitUntraced: std.ctypes.int = 2

  // WCONTINUED is available on the supported contemporary Unix systems,
  // although its numeric value is ABI-specific.
  pub let WaitContinued: std.ctypes.int =
    when OS == .Linux { 8 }
    else when OS == .MacOS
      || OS == .FreeBSD
      || OS == .OpenBSD
      || OS == .NetBSD
      || OS == .DragonFly { 16 }
    else { 0 }

  // Equivalent to the standard WIFEXITED(status) macro.
  pub let wait_exited(status: wait_status_t): bool {
    return (status & 0x7f) == 0.(wait_status_t)
  }

  // Equivalent to WEXITSTATUS(status).
  // Call only when wait_exited(status) is true.
  pub let wait_exit_status(status: wait_status_t): std.ctypes.int {
    return ((status >> 8) & 0xff).(std.ctypes.int)
  }

  // Equivalent to WIFSIGNALED(status).
  pub let wait_signalled(status: wait_status_t): bool {
    let signal = status & 0x7f
    return signal != 0.(wait_status_t) && signal != (0x7f).(wait_status_t)
  }

  // Equivalent to WTERMSIG(status).
  // Call only when wait_signalled(status) is true.
  pub let wait_term_signal(status: wait_status_t): signal_t {
    return (status & (0x7f).(wait_status_t)).(signal_t)
  }

  // Equivalent to WIFSTOPPED(status).
  pub let wait_stopped(status: wait_status_t): bool {
    return (status & 0xff) == (0x7f).(wait_status_t)
  }

  // Equivalent to WSTOPSIG(status).
  // Call only when wait_stopped(status) is true.
  pub let wait_stop_signal(status: wait_status_t): signal_t {
    return ((status >> 8) & 0xff).(signal_t)
  }

  // Equivalent to WCOREDUMP(status). This is widely available but is not
  // required by POSIX.
  pub let wait_core_dumped(status: wait_status_t): bool {
    return (status & 0x80) != 0.(wait_status_t)
  }

  // WIFCONTINUED has different encodings between Linux and BSD-derived ABIs.
  pub let wait_continued(status: wait_status_t): bool {
    when OS == .Linux {
      return status == (0xffff).(wait_status_t)
    } else {
      return status == (0x13).(wait_status_t)
    }
  }

  // ---------------------------------------------------------------------------
  // Process identity
  // ---------------------------------------------------------------------------

  pub let getpid(): pid_t @foreign
  pub let getppid(): pid_t @foreign

  // ---------------------------------------------------------------------------
  // Process groups and sessions
  // ---------------------------------------------------------------------------

  pub let getpgrp(): pid_t @foreign

  pub let getpgid(pid: pid_t): pid_t @foreign

  pub let setpgid(
    pid: pid_t,
    pgid: pid_t,
  ): std.ctypes.int @foreign

  pub let getsid(pid: pid_t): pid_t @foreign
  pub let setsid(): pid_t @foreign

  // Foreground process-group management for terminals.
  pub let tcgetpgrp(fd: fd_t): pid_t @foreign

  pub let tcsetpgrp(
    fd: fd_t,
    pgrp: pid_t,
  ): std.ctypes.int @foreign

  // ---------------------------------------------------------------------------
  // Signals
  // ---------------------------------------------------------------------------

  pub let kill(
    pid: pid_t,
    signal: signal_t,
  ): std.ctypes.int @foreign

  pub let raise(signal: signal_t): std.ctypes.int @foreign

  // kill() pid argument behaviour:
  //
  //   pid > 0   send to one process
  //   pid == 0  send to the caller's process group
  //   pid == -1 send to every permitted process
  //   pid < -1  send to process group -pid

  pub let SignalHangup: signal_t = 1
  pub let SignalInterrupt: signal_t = 2
  pub let SignalQuit: signal_t = 3
  pub let SignalIllegalInstruction: signal_t = 4
  pub let SignalAbort: signal_t = 6
  pub let SignalFloatingPointException: signal_t = 8
  pub let SignalKill: signal_t = 9
  pub let SignalSegmentationFault: signal_t = 11
  pub let SignalPipe: signal_t = 13
  pub let SignalAlarm: signal_t = 14
  pub let SignalTerminate: signal_t = 15

  // These values differ on Linux and BSD-derived systems.
  pub let SignalChild: signal_t =
    when OS == .Linux { 17 }
    else when OS == .MacOS
      || OS == .FreeBSD
      || OS == .OpenBSD
      || OS == .NetBSD
      || OS == .DragonFly { 20 }
    else { 0 }

  pub let SignalContinue: signal_t =
    when OS == .Linux { 18 }
    else when OS == .MacOS
      || OS == .FreeBSD
      || OS == .OpenBSD
      || OS == .NetBSD
      || OS == .DragonFly { 19 }
    else { 0 }

  pub let SignalStop: signal_t =
    when OS == .Linux { 19 }
    else when OS == .MacOS
      || OS == .FreeBSD
      || OS == .OpenBSD
      || OS == .NetBSD
      || OS == .DragonFly { 17 }
    else { 0 }

  pub let SignalTerminalStop: signal_t =
    when OS == .Linux { 20 }
    else when OS == .MacOS
      || OS == .FreeBSD
      || OS == .OpenBSD
      || OS == .NetBSD
      || OS == .DragonFly { 18 }
    else { 0 }

  // ---------------------------------------------------------------------------
  // File descriptors and redirection
  // ---------------------------------------------------------------------------

  pub let StandardInput: fd_t = 0
  pub let StandardOutput: fd_t = 1
  pub let StandardError: fd_t = 2

  pub let PipeRead: std.ctypes.size_t = 0
  pub let PipeWrite: std.ctypes.size_t = 1

  // pipefd must point to storage for two std.ctypes.int values:
  // pipefd[PipeRead] and pipefd[PipeWrite].
  pub let pipe(pipefd: *mut fd_t): std.ctypes.int @foreign

  pub let dup(oldfd: fd_t): fd_t @foreign

  pub let dup2(
    oldfd: fd_t,
    newfd: fd_t,
  ): fd_t @foreign

  pub let close(fd: fd_t): std.ctypes.int @foreign

  // ---------------------------------------------------------------------------
  // Environment and working directory
  // ---------------------------------------------------------------------------

  pub let chdir(path: cstr): std.ctypes.int @foreign
  pub let fchdir(fd: fd_t): std.ctypes.int @foreign

  pub let getcwd(
    buffer: *mut std.ctypes.char,
    size: std.ctypes.size_t,
  ): *mut std.ctypes.char @foreign

  pub let setenv(
    name: cstr,
    value: cstr,
    overwrite: std.ctypes.int,
  ): std.ctypes.int @foreign

  pub let unsetenv(name: cstr): std.ctypes.int @foreign

  // ---------------------------------------------------------------------------
  // Process scheduling
  // ---------------------------------------------------------------------------

  pub let nice(increment: std.ctypes.int): std.ctypes.int @foreign

  pub let PriorityProcess: std.ctypes.int = 0
  pub let PriorityProcessGroup: std.ctypes.int = 1
  pub let PriorityUser: std.ctypes.int = 2

  pub let getpriority(
    which: std.ctypes.int,
    who: std.ctypes.unsigned_int,
  ): std.ctypes.int @foreign

  pub let setpriority(
    which: std.ctypes.int,
    who: std.ctypes.unsigned_int,
    priority: std.ctypes.int,
  ): std.ctypes.int @foreign
}

// -----------------------------------------------------------------------------
// Linux-specific process APIs
// -----------------------------------------------------------------------------

when OS == .Linux {

  // GNU extension: PATH lookup with an explicit environment.
  pub let execvpe(
    file: cstr,
    argv: **std.ctypes.char,
    envp: **std.ctypes.char,
  ): std.ctypes.int @foreign

  // Linux versions allowing atomic close-on-exec configuration.
  pub let pipe2(
    pipefd: *mut fd_t,
    flags: std.ctypes.int,
  ): std.ctypes.int @foreign

  pub let dup3(
    oldfd: fd_t,
    newfd: fd_t,
    flags: std.ctypes.int,
  ): fd_t @foreign

  pub let CloseOnExec: std.ctypes.int = 0x80000
  pub let NonBlocking: std.ctypes.int = 0x800

  // Linux pidfd APIs provide race-resistant references to processes.
  pub let pidfd_open(
    pid: pid_t,
    flags: std.ctypes.unsigned_int,
  ): fd_t @foreign

  pub let pidfd_send_signal(
    pidfd: fd_t,
    signal: signal_t,
    info: *void,
    flags: std.ctypes.unsigned_int,
  ): std.ctypes.int @foreign
}

}
