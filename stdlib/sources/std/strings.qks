module std

when NoLibc {
  let strlen(s: cstr): usz {
    if s == nil {
      return 0
    }

    let mut l: usz = 0
    for s[l] != '\0' {
      l += 1
    }
    return l
  }
} else {
  import std.libc

  let strlen(s: cstr): usz =
    std.libc.strlen(s)
}

// important: this method does not copy self, it just creates a str view of the cstr
// therefore, the c string must live as long as the returned str is used, otherwise it will be a dangling pointer
// passing a null pointer is undefined behaviour
pub let cstr.to_str(self): str =
  self[:strlen(self)].(str)

import std.alloc

pub let str.read(*mut self, buffer: []mut u8): usz {
  let count = if @len(buffer) < @len(self.*) { @len(buffer) } else { @len(self.*) }

  let mut index: usz = 0
  for index < count {
    buffer[index] = self.*[index]
    index += 1
  }
  self.* = self.*[count:]
  return count
}

pub let cstr.read(*mut self, buffer: []mut u8): usz {
  if self.* == nil {
    return 0
  }

  let mut count: usz = 0
  for count < @len(buffer) && self.*[count] != '\0' {
    buffer[count] = self.*[count]
    count += 1
  }
  self.* = self.* + count.(isz)
  return count
}

// important: due to us not being able to guarantee that self contains a null terminator,
// this method is forced to allocate a new buffer and copy the contents of self into it, appending a null terminator at the end
pub let str.to_cstr(self, allocator: mut dyn std.alloc.Allocator): *mut u8 {
  if allocator == nil || @len(self) == ~0.(usz) {
    return nil
  }

  let allocated, success = allocator.allocate_bytes(
    @len(self) + 1,
    @alignof(u8),
  )
  if !success {
    return nil
  }
  let buf = allocated.(*mut u8)
  if buf == nil {
    return nil
  }

  let mut index: usz = 0
  for index < @len(self) {
    buf[index] = self[index]
    index += 1
  }
  buf[@len(self)] = '\0'
  return buf
}
