module std

pub let (*T).is_nil<T>(self): bool = self == nil

pub let (*mut T).as_const<T>(self): *T = self

pub let (*T).as_slice<T>(self, length: usz): []T {
  if self == nil { return self[:0] }
  return self[:length]
}

pub let (*mut T).as_slice<T>(self, length: usz): []mut T {
  if self == nil { return self[:0] }
  return self[:length]
}
