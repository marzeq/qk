module std.os

pub let mut args: []str = ---

when !NoLibc {
  import std.alloc
  import std.libc
  import std.strings

  // Returns a borrowed view into storage owned by the host environment.
  // The view may be invalidated by a later environment mutation.
  pub let environment_variable(name: str): (str, bool) {
    let mut lc = std.alloc.LibcAllocator.init()
    let allocator = lc.&mut.(*mut dyn std.alloc.Allocator)
    let c_name = name.to_cstr(allocator)
    if c_name == nil { return "", false }

    let value = std.libc.getenv(c_name)
    allocator.free_bytes(c_name, @len(name) + 1, @alignof(u8))
    if value == nil { return "", false }
    return value.(cstr).to_str(), true
  }

  pub let getenv(name: str): (str, bool) = environment_variable(name)

  // Copies an environment variable into allocator-owned storage.
  // found is false both when the variable is absent and when allocation fails.
  pub let environment_variable_owned(
    allocator: *mut dyn std.alloc.Allocator,
    name: str,
  ): (std.strings.StringBuilder, bool) {
    let value, found = environment_variable(name)
    let mut result = std.strings.StringBuilder.init(allocator)
    if !found { return result, false }
    if result.write(value.([]u8)) != @len(value) {
      result.deinit()
      return std.strings.StringBuilder.init(allocator), false
    }
    return result, true
  }

  pub let getenv_owned(
    allocator: *mut dyn std.alloc.Allocator,
    name: str,
  ): (std.strings.StringBuilder, bool) =
    environment_variable_owned(allocator, name)

  pub let Error = type struct {
    code: i32,
  }

  pub let Error.none(): Error = .{ code=0 }

  pub let Error.out_of_memory(): Error = .{ code=-1 }

  pub let Error.invalid_handle(): Error = .{ code=-2 }

  pub let Error.no_progress(): Error = .{ code=-3 }

  pub let Error.is_none(self): bool = self.code == 0

  pub let Error.is_error(self): bool = self.code != 0

  // The returned view points to platform-owned storage and should be consumed
  // before requesting another error message.
  pub let Error.message(self): str {
    if self.code == 0 { return "no error" }
    if self.code == -1 { return "out of memory" }
    if self.code == -2 { return "invalid handle" }
    if self.code == -3 { return "operation made no progress" }
    let message = std.libc.strerror(self.code)
    let mut length: usz = 0
    for message[length] != '\0' { length += 1 }
    return message[0:length].(str)
  }

  pub let last_error(): Error = .{ code=std.libc.errno_location().* }

  pub let exit(code: i32): void @noreturn {
    std.libc.exit(code)
  }
}
