module std.alloc

// Allocators use one alignment for both the old and new allocation when
// resizing. A zero-byte allocation or resize succeeds with a nil pointer.
pub let Allocator = type trait {
  let allocate_bytes(
    *mut self,
    size: usz,
    align: usz,
  ): (*mut void, bool)
  let free_bytes(
    *mut self,
    ptr: *mut void,
    size: usz,
    align: usz,
  ): void
  let resize_bytes(
    *mut self,
    ptr: *mut void,
    old_size: usz,
    new_size: usz,
    align: usz,
  ): (*mut void, bool)
}
