module std

when not NoLibc {

import std.libc

pub let str.to_cstr(self): *mut char {
  let buf = std.libc.malloc(len(self) + 1).(*mut char)
  if buf == nil {
    return nil
  }

  std.libc.memcpy(buf, self.(*char), len(self))
  buf[len(self)] = '\0'
  return buf
}

pub let str.eq(self, other: str): bool {
  if len(self) != len(other) {
    return false
  }

  return std.libc.memcmp(self.(*char), other.(*char), len(self)) == 0
}

pub let cstr.to_str(self): str {
  if self == nil {
    return ""
  }

  let n = std.libc.strlen(self)

  let mut data: [char] = ['\0'; n]
  std.libc.memcpy(data.(*mut char), self, n)

  return data.(str)
}

}
