module std

import std.libc

let HasDisplayPrimitives = comptime not NoLibc

pub let Display = type trait {
  let display(self): void
}

when HasDisplayPrimitives {
  let i8.display(self): void { std.libc.printf(c"%hhd", self) }
  let i16.display(self): void { std.libc.printf(c"%hd", self) }
  let i32.display(self): void { std.libc.printf(c"%d", self) }
  let i64.display(self): void { std.libc.printf(c"%lld", self) }
  let isz.display(self): void { std.libc.printf(c"%zd", self) }

  let u8.display(self): void { std.libc.printf(c"%hhu", self) }
  let u16.display(self): void { std.libc.printf(c"%hu", self) }
  let u32.display(self): void { std.libc.printf(c"%u", self) }
  let u64.display(self): void { std.libc.printf(c"%llu", self) }
  let usz.display(self): void { std.libc.printf(c"%zu", self) }

  let f32.display(self): void { std.libc.printf(c"%g", self) }
  let f64.display(self): void { std.libc.printf(c"%g", self) }

  let char.display(self): void { std.libc.putchar(self.(i32)) }

  let bool.display(self): void {
    if self { std.libc.printf(c"true") }
    else { std.libc.printf(c"false") }
  }

  let str.display(self): void {
    std.libc.printf(c"%.*s", len(self).(i32), self.(cstr))
  }

  let cstr.display(self): void { std.libc.printf(c"%s", self) }
}
