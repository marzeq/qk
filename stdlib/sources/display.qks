module std

import std.libc

let HasDisplayPrimitives = comptime not NoLibc

pub let Display = type trait {
  let display(self): void
}

when HasDisplayPrimitives {
  pub let i8.display(self): void { std.libc.printf(c"%hhd", self) }
  pub let i16.display(self): void { std.libc.printf(c"%hd", self) }
  pub let i32.display(self): void { std.libc.printf(c"%d", self) }
  pub let i64.display(self): void { std.libc.printf(c"%lld", self) }
  pub let isz.display(self): void { std.libc.printf(c"%zd", self) }

  pub let u8.display(self): void { std.libc.printf(c"%hhu", self) }
  pub let u16.display(self): void { std.libc.printf(c"%hu", self) }
  pub let u32.display(self): void { std.libc.printf(c"%u", self) }
  pub let u64.display(self): void { std.libc.printf(c"%llu", self) }
  pub let usz.display(self): void { std.libc.printf(c"%zu", self) }

  pub let f32.display(self): void { std.libc.printf(c"%g", self) }
  pub let f64.display(self): void { std.libc.printf(c"%g", self) }

  pub let char.display(self): void { std.libc.putchar(self.(i32)) }

  pub let bool.display(self): void {
    if self { std.libc.printf(c"true") }
    else { std.libc.printf(c"false") }
  }

  pub let str.display(self): void {
    std.libc.printf(c"%.*s", len(self).(i32), self.(cstr))
  }

  pub let cstr.display(self): void { std.libc.printf(c"%s", self) }
}
